# =============================
# Dependencies
# =============================
include(FetchContent)

# toml11 for parameter file parsing
FetchContent_Declare(
    toml11
    GIT_REPOSITORY "https://github.com/ToruNiina/toml11"
    GIT_TAG "v4.4.0"
)
FetchContent_MakeAvailable(toml11)

# dendrolib
set(DENDRO_dendrolib_DIR "" CACHE PATH "Path to local dendrolib source (optional)")
set(DENDRO_dendrolib_GIT_TAG "master" CACHE STRING "Git tag/branch/commit for dendrolib")

if(IS_DIRECTORY ${DENDRO_dendrolib_DIR})
  message(STATUS "Using user-provided dendrolib from: ${DENDRO_dendrolib_DIR}")
  add_subdirectory(${DENDRO_dendrolib_DIR} dendrolib)
else()
  message(STATUS "Fetching dendrolib from repository...")
  FetchContent_Declare(
    dendrolib
    GIT_REPOSITORY "https://github.com/paralab/Dendro-5.01"
    GIT_TAG ${DENDRO_dendrolib_GIT_TAG}
  )
  FetchContent_MakeAvailable(dendrolib)
  set(DENDRO_dendrolib_DIR ${dendrolib_SOURCE_DIR} CACHE INTERNAL "Fetched dendrolib path")
endif()

# solver subdirectory
add_subdirectory(solver)
