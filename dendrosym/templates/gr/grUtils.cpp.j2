 * dispatches based on the id_type parameter from the toml file.
 */
void initDataFuncToPhysCoords(const double xx, const double yy,
                              const double zz, double *var) {

    // zero everything first
    for (unsigned int i = 0; i < {{ evolution_num_vars }}; i++) {
        var[i] = 0.0;
    }

    // TODO: wire this to the runtime parameter once parameters are set up
    unsigned int id_type = 0;

    switch (id_type) {
        case 0:
            minkowskiInit(xx, yy, zz, var);
            break;

        // add cases as you implement more initial data:
        // case 1: punctureData(xx, yy, zz, var); break;
        // case 2: schwarzschildInit(xx, yy, zz, var); break;

        default:
            minkowskiInit(xx, yy, zz, var);
            break;
    }
}

