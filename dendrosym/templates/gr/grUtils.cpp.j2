/**
 * @brief Initial data dispatcher. Called for every grid point during init.
 *
 * Receives grid (octree) coordinates. Converts to physical coords
 * via the GRIDX_TO_X macros, then dispatches to the appropriate
 * initial data function based on the id_type runtime parameter.
 */
void initDataFuncToPhysCoords(const double xx1, const double yy1,
                              const double zz1, double *var) {
    // convert grid coords to physical coords
    const double xx = GRIDX_TO_X(xx1);
    const double yy = GRIDY_TO_Y(yy1);
    const double zz = GRIDZ_TO_Z(zz1);

    // zero everything first
    for (unsigned int i = 0; i < {{ evolution_num_vars }}; i++) {
        var[i] = 0.0;
    }

    switch ({{ project_upper }}_ID_TYPE) {
        case 0:
            minkowskiInit(xx, yy, zz, var);
            break;

{% if symbolic_init_code %}
        case 2:
            // auto-generated from symbolic expressions in the python config
            {{ symbolic_init_name }}(xx, yy, zz, var);
            break;
{% endif %}

{% for idt in initial_data_types %}
        case {{ idt.id }}:
            {{ idt.function }}(xx, yy, zz, var);
            break;
{% endfor %}

        default:
            std::cout << "Unknown ID type: " << {{ project_upper }}_ID_TYPE << std::endl;
            exit(1);
            break;
    }
}

