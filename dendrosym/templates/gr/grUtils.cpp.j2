// -------------------------------------------------------------------------
// TwoPunctures mesh estimate -- analytic Brill-Lindquist + conformally-flat.
// Aij omitted (smooth, doesn't drive AMR).
// -------------------------------------------------------------------------
double computeWTolDCoords(double x, double y, double z, double *hx) {
    const double tolMin = {{ project_upper }}_WAVELET_TOL;
    const double tolMax = {{ project_upper }}_WAVELET_TOL_MAX;
    const double R0     = {{ project_upper }}_WAVELET_TOL_FUNCTION_R0;
    const double R1     = {{ project_upper }}_WAVELET_TOL_FUNCTION_R1;
    const double r      = std::sqrt(x * x + y * y + z * z);

    // Degenerate config: no usable ramp, so stay flat rather than divide by 0.
    if (!(tolMax > tolMin) || !(R1 > R0)) return tolMin;

    switch ({{ project_upper }}_USE_WAVELET_TOL_FUNCTION) {
        case 1:  // linear ramp tolMin@R0 -> tolMax@R1 (BSSN computeWTol)
            return std::min(
                tolMax, std::max(tolMin, (tolMax - tolMin) / (R1 - R0) *
                                                 (r - R0) +
                                             tolMin));

        case 3: {
            // Decade-exponential falloff. BSSN keys the ceiling off its
            // outermost GW extraction radius; there is none here, so tolMax is
            // the ceiling and the profile is purely radial.
            if (r < R0) return tolMin;
            const double fac = (R1 - R0) / std::log10(tolMax / tolMin);
            return std::min(tolMax,
                            tolMin * std::pow(10.0, (r - R0) / fac));
        }

        case 0:
            return tolMin;

        default: {
            // 2/4/5/6 depend on GW radii or BH-tracking state not carried here.
            // Warn rather than silently flatten -- a flat tolerance saturates
            // below any depth ceiling and makes maxdepth look inert.
            static bool warned = false;
            if (!warned) {
                warned = true;
                std::cerr << "[{{ namespace }}] WARNING: use_wavelet_tol_function = "
                          << {{ project_upper }}_USE_WAVELET_TOL_FUNCTION
                          << " is not implemented; falling back to a flat "
                             "wavelet_tol. Supported: 0, 1, 3." << std::endl;
            }
            return tolMin;
        }
    }
}

void twoPuncturesInitEstimate(double x, double y, double z, double *var) {
    const double xx = x - TPID::center_offset[0];
    const double yy = y - TPID::center_offset[1];
    const double zz = z - TPID::center_offset[2];

    const double dx_p = xx - TPID::par_b;
    const double dx_m = xx + TPID::par_b;
    const double eps2 = TPID::TCP_epsilon * TPID::TCP_epsilon;
    const double r_plus  = std::sqrt(dx_p * dx_p + yy * yy + zz * zz + eps2);
    const double r_minus = std::sqrt(dx_m * dx_m + yy * yy + zz * zz + eps2);

    const double psi_BL = 1.0
                        + 0.5 * TPID::par_m_plus  / r_plus
                        + 0.5 * TPID::par_m_minus / r_minus;

    // BSSN chi for conformally flat BL data: chi = 1/psi_BL^4.
    var[VAR::U_CHI]      = 1.0 / std::pow(psi_BL, 4);
    var[VAR::U_GT00] = 1.0;
    var[VAR::U_GT11] = 1.0;
    var[VAR::U_GT22] = 1.0;

    if (TPID::initial_lapse == 2) {
        var[VAR::U_ALPHA] = std::pow(psi_BL, TPID::initial_lapse_psi_exponent);
    } else {
        var[VAR::U_ALPHA] = 1.0;
    }
}
