/**
 * @file tpid_main.cpp
 * @brief Standalone TPID solver for {{ project_name }}.
 *
 * Run once (single MPI rank, OpenMP-parallel) to do the Chebyshev/Fourier
 * spectral solve for the Bowen-York momentum constraint and write
 * <tpid_file_prefix>_tpid_sol.bin. The main solver reads that file at startup
 * whenever id_type = 0.
 *
 * Usage:  ./{{ project_name }}_tpid <paramFile.toml> <num_omp_threads>
 *
 * Mirrors BSSN_GR/src/TPID.cpp; the solve itself lives in dendrolib's
 * GR/TwoPunctures.
 *
 * Generated once, then yours: written only when absent, so edits survive a
 * regenerate.
 */

#include <iostream>

#include "TwoPunctures.h"
#include "{{ project_name }}_tpid_writer.h"
#include "grUtils.h"
#include "mpi.h"
#include "parameters.h"

int main(int argc, char **argv) {
    MPI_Comm comm = MPI_COMM_WORLD;
    MPI_Init(&argc, &argv);

    int npes, rank;
    MPI_Comm_size(comm, &npes);
    MPI_Comm_rank(comm, &rank);

    if (npes > 1) {
        std::cout << "tpid should be executed as a single mpi task"
                  << std::endl;
        MPI_Abort(comm, 0);
    }

    if (argc < 3) {
        std::cout << "ERROR: Not Enough Arguments!" << std::endl
                  << "Usage: " << argv[0] << " paramFile numthreads"
                  << std::endl;
        MPI_Finalize();
        return 0;
    }

    const unsigned int nthreads = atoi(argv[2]);
    TP_OMP_THREADS              = nthreads;
    TP_MPI_COMM                 = comm;

    TPID::registerPunctureVarsWriter({{ tpid_writer }});

    std::cout << " reading parameter file: " << argv[1] << std::endl;
    {{ namespace }}::readParamFile(argv[1], comm);

    double massp, massm, massp_adm, massm_adm, E, J1, J2, J3;
    double t1      = MPI_Wtime();
    TP_SOLVE_VALID = 0;
    if (TP_SOLVE_VALID == 0) {
        TPStore(&massp, &massm, &massp_adm, &massm_adm, &E, &J1, &J2, &J3,
                TPID::FILE_PREFIX.c_str());
        TP_SOLVE_VALID = 1;
    }
    double t2 = MPI_Wtime();
    std::cout << "TP solver time: " << (t2 - t1) << std::endl;

    MPI_Finalize();
    return 0;
}
