/**
 * @file parameters.h
 * @brief Parameter declarations for the {{ project_name }} solver.
 *
 * Generated by dendrosym. Safe to edit -- add new parameters as needed.
 *
 * Parameters are read from a TOML file at runtime. The TOML file uses
 * sections to organize parameters by category:
 *
 *   [solver]          - mesh, time stepping, I/O
 *   [physics]         - equation-specific theory parameters
 *   [initial_data]    - initial condition setup
 *   [bh1] / [bh2]    - per-black-hole parameters
 *   [refinement]      - AMR settings
 *   [dissipation]     - KO dissipation settings
 *   [wave_extraction] - gravitational wave extraction
 */

