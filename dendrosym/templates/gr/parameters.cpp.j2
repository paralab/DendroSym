    // These are read with their short names (no project prefix)
    // =================================================================
{% for pvar in physics_params | default([]) %}
{% if pvar.num_params > 1 %}
    READ_OPTIONAL_ARRAY("physics", "{{ pvar.toml_key }}", {{ pvar.cpp_var }});
{% else %}
    READ_OPTIONAL("physics", "{{ pvar.toml_key }}", {{ pvar.cpp_var }});
{% endif %}
{% endfor %}

    // evolution constraint floors (optional; compiled defaults 1e-4)
{% for vname in pos_floor_vars | default(['chi', 'alpha']) %}
    READ_OPTIONAL("physics", "{{ vname | lower }}_floor", {{ vname | upper }}_FLOOR);
{% endfor %}

    // =================================================================
    // [initial_data]
    // =================================================================
    READ_OPTIONAL("initial_data", "id_type", {{ project_upper }}_ID_TYPE);

{% if enable_bh_tracking %}
    // read BH parameters from [bh1] and [bh2] sections
    {
        {{ project_upper }}_BH1_MAX_LEV = {{ project_upper }}_MAXDEPTH;
        {{ project_upper }}_BH2_MAX_LEV = {{ project_upper }}_MAXDEPTH;

        double mass = 0, bx = 0, by = 0, bz = 0, vx = 0, vy = 0, vz = 0;
        double spin = 0, spin_theta = 0, spin_phi = 0;

        if (root.contains("bh1")) {
            const auto& bh = root.at("bh1");
            if (bh.contains("mass")) mass = toml::find<double>(bh, "mass");
            if (bh.contains("x")) bx = toml::find<double>(bh, "x");
            if (bh.contains("y")) by = toml::find<double>(bh, "y");
            if (bh.contains("z")) bz = toml::find<double>(bh, "z");
            if (bh.contains("spin")) spin = toml::find<double>(bh, "spin");
            if (bh.contains("max_lev"))
                {{ project_upper }}_BH1_MAX_LEV =
                    toml::find<unsigned int>(bh, "max_lev");
            if (bh.contains("amr_r"))
                {{ project_upper }}_BH1_AMR_R = toml::find<double>(bh, "amr_r");
            if (bh.contains("constraint_r"))
                {{ project_upper }}_BH1_CONSTRAINT_R =
                    toml::find<double>(bh, "constraint_r");
        }
        BH1 = BH(mass, bx, by, bz, vx, vy, vz, spin, spin_theta, spin_phi);
        {{ project_upper }}_BH_LOC[0] = Point(bx, by, bz);

        mass = 0; bx = 0; by = 0; bz = 0;
        if (root.contains("bh2")) {
            const auto& bh = root.at("bh2");
            if (bh.contains("mass")) mass = toml::find<double>(bh, "mass");
            if (bh.contains("x")) bx = toml::find<double>(bh, "x");
            if (bh.contains("y")) by = toml::find<double>(bh, "y");
            if (bh.contains("z")) bz = toml::find<double>(bh, "z");
            if (bh.contains("spin")) spin = toml::find<double>(bh, "spin");
            if (bh.contains("max_lev"))
                {{ project_upper }}_BH2_MAX_LEV =
                    toml::find<unsigned int>(bh, "max_lev");
            if (bh.contains("amr_r"))
                {{ project_upper }}_BH2_AMR_R = toml::find<double>(bh, "amr_r");
            if (bh.contains("constraint_r"))
                {{ project_upper }}_BH2_CONSTRAINT_R =
                    toml::find<double>(bh, "constraint_r");
        }
        BH2 = BH(mass, bx, by, bz, vx, vy, vz, spin, spin_theta, spin_phi);
        {{ project_upper }}_BH_LOC[1] = Point(bx, by, bz);

        if (rank == 0) {
            std::cout << "BH1: mass=" << BH1.getBHMass()
                      << " loc=(" << BH1.getBHCoordX() << ","
                      << BH1.getBHCoordY() << "," << BH1.getBHCoordZ() << ")"
                      << std::endl;
        }
    }
{% endif %}

{% if enable_tpid %}

    READ_OPTIONAL("initial_data", "tpid_file_prefix", TPID::FILE_PREFIX);
    READ_OPTIONAL("initial_data", "par_b", TPID::par_b);
    READ_OPTIONAL("initial_data", "par_m_plus", TPID::par_m_plus);
    READ_OPTIONAL("initial_data", "par_m_minus", TPID::par_m_minus);
    READ_OPTIONAL_ARRAY("initial_data", "par_P_plus", TPID::par_P_plus);
    READ_OPTIONAL_ARRAY("initial_data", "par_P_minus", TPID::par_P_minus);
    READ_OPTIONAL_ARRAY("initial_data", "par_S_plus", TPID::par_S_plus);
    READ_OPTIONAL_ARRAY("initial_data", "par_S_minus", TPID::par_S_minus);
    READ_OPTIONAL_ARRAY("initial_data", "center_offset", TPID::center_offset);

    // Seed the moving-puncture tracker from the TwoPunctures geometry:
    // the punctures sit at (center_offset +/- par_b * x_hat). Without explicit
    // [bh1]/[bh2] sections the tracked locations would otherwise default to the
    // origin -- which zeros the trajectory and trips a spurious t=0 merger.
    if (!root.contains("bh1") && !root.contains("bh2")) {
        {{ project_upper }}_BH_LOC[0] = Point(TPID::center_offset[0] + TPID::par_b,
                                              TPID::center_offset[1],
                                              TPID::center_offset[2]);
        {{ project_upper }}_BH_LOC[1] = Point(TPID::center_offset[0] - TPID::par_b,
                                              TPID::center_offset[1],
                                              TPID::center_offset[2]);
    }
    READ_OPTIONAL("initial_data", "give_bare_mass", TPID::give_bare_mass);
    READ_OPTIONAL("initial_data", "initial_lapse", TPID::initial_lapse);
    // spectral solver tuning -- expose every TPID knob so the TOML can
    // shrink npoints, loosen Newton tol, skip the momentum constraint, etc.
    READ_OPTIONAL("initial_data", "grid_setup_method", TPID::grid_setup_method);
    READ_OPTIONAL("initial_data", "solve_momentum_constraint", TPID::solve_momentum_constraint);
    READ_OPTIONAL("initial_data", "verbose", TPID::verbose);
    READ_OPTIONAL("initial_data", "adm_tol", TPID::adm_tol);
    READ_OPTIONAL("initial_data", "Newton_tol", TPID::Newton_tol);
    READ_OPTIONAL("initial_data", "initial_lapse_psi_exponent", TPID::initial_lapse_psi_exponent);
    READ_OPTIONAL("initial_data", "npoints_A", TPID::npoints_A);
    READ_OPTIONAL("initial_data", "npoints_B", TPID::npoints_B);
    READ_OPTIONAL("initial_data", "npoints_phi", TPID::npoints_phi);
    READ_OPTIONAL("initial_data", "nintegration_theta", TPID::nintegration_theta);
    READ_OPTIONAL("initial_data", "nintegration_phi", TPID::nintegration_phi);
    READ_OPTIONAL("initial_data", "use_Dilaton", TPID::use_Dilaton);
    READ_OPTIONAL("initial_data", "use_Interpolated_solution", TPID::use_Interpolated_solution);
    READ_OPTIONAL("initial_data", "replace_lapse_with_sqrt_chi", TPID::replace_lapse_with_sqrt_chi);
    READ_OPTIONAL("initial_data", "par_alpha0", TPID::par_alpha0);
    READ_OPTIONAL("initial_data", "par_q_plus", TPID::par_q_plus);
    READ_OPTIONAL("initial_data", "par_q_minus", TPID::par_q_minus);
    READ_OPTIONAL("initial_data", "target_M_plus", TPID::target_M_plus);
    READ_OPTIONAL("initial_data", "target_M_minus", TPID::target_M_minus);
{% endif %}

    // =================================================================
    // [wave_extraction]
    // =================================================================
{% if enable_gw_extraction %}
    READ_OPTIONAL("wave_extraction", "extract_freq", {{ project_upper }}_GW_EXTRACT_FREQ);
{% if enable_gw_extraction %}
    READ_OPTIONAL("wave_extraction", "num_radaii", GW::{{ project_upper }}_GW_NUM_RADAII);
    READ_OPTIONAL("wave_extraction", "num_lmodes", GW::{{ project_upper }}_GW_NUM_LMODES);
    // TODO: read radii and l_modes arrays from TOML
{% endif %}
{% endif %}

    // =================================================================
    // [logging]
    // =================================================================
    READ_OPTIONAL("logging", "log_file", DENDRO_LOG_FILE);
    READ_OPTIONAL("logging", "log_file_level", DENDRO_LOG_FILE_LEVEL);
    READ_OPTIONAL("logging", "log_console_level", DENDRO_LOG_CONSOLE_LEVEL);
    READ_OPTIONAL("logging", "force_file_flush", DENDRO_LOG_FORCE_FILE_FLUSH);

{% if enable_ah %}
#ifdef SOLVER_ENABLE_AH
    // =================================================================
    // [apparent_horizon]
    // =================================================================
    READ_OPTIONAL("apparent_horizon", "solver_freq", AH::AH_SOLVER_FREQ);

    // read bhahaha config from [apparent_horizon] section
    if (root.contains("apparent_horizon")) {
        const auto& ah_sec = root.at("apparent_horizon");

        // scalar params
        if (ah_sec.contains("n_horizons")) AH::N_HORIZONS = toml::find<unsigned int>(ah_sec, "n_horizons");
        if (ah_sec.contains("n_resolutions_multigrid")) AH::N_RESOLUTIONS_MULTIGRID = toml::find<unsigned int>(ah_sec, "n_resolutions_multigrid");
        if (ah_sec.contains("ntheta_max")) AH::NTHETA_MAX = toml::find<int>(ah_sec, "ntheta_max");
        if (ah_sec.contains("nphi_max")) AH::NPHI_MAX = toml::find<int>(ah_sec, "nphi_max");
        if (ah_sec.contains("save_dir")) AH::AH_SAVE_DIR = toml::find<std::string>(ah_sec, "save_dir");
        if (ah_sec.contains("num_resolutions_after_find")) AH::NUM_RESOLUTIONS_AFTER_FIND = toml::find<int>(ah_sec, "num_resolutions_after_find");
        if (ah_sec.contains("enable_eta_varying_alg")) AH::ENABLE_ETA_VARYING_ALG = toml::find<int>(ah_sec, "enable_eta_varying_alg");
        if (ah_sec.contains("verbosity_level")) AH::VERBOSITY_LEVEL = toml::find<int>(ah_sec, "verbosity_level");

        // vector params (per-horizon)
        if (ah_sec.contains("max_iterations")) AH::MAX_ITERATIONS = toml::find<std::vector<int>>(ah_sec, "max_iterations");
        if (ah_sec.contains("m_scale")) AH::M_SCALE = toml::find<std::vector<double>>(ah_sec, "m_scale");
        if (ah_sec.contains("cfl_factor")) AH::CFL_FACTOR = toml::find<std::vector<double>>(ah_sec, "cfl_factor");
        if (ah_sec.contains("theta_l2_m_tol")) AH::THETA_L2_M_TOL = toml::find<std::vector<double>>(ah_sec, "theta_l2_m_tol");
        if (ah_sec.contains("theta_linf_m_tol")) AH::THETA_LINF_M_TOL = toml::find<std::vector<double>>(ah_sec, "theta_linf_m_tol");
        if (ah_sec.contains("eta_damp_m")) AH::ETA_DAMP_M = toml::find<std::vector<double>>(ah_sec, "eta_damp_m");
        if (ah_sec.contains("ko_strength")) AH::KO_STRENGTH = toml::find<std::vector<double>>(ah_sec, "ko_strength");
        if (ah_sec.contains("max_search_radius")) AH::MAX_SEARCH_RADIUS = toml::find<std::vector<double>>(ah_sec, "max_search_radius");
        if (ah_sec.contains("nr_interp_max")) AH::NR_INTERP_MAX = toml::find<std::vector<int>>(ah_sec, "nr_interp_max");
        if (ah_sec.contains("initial_x_center")) AH::INITIAL_X_CENTER = toml::find<std::vector<double>>(ah_sec, "initial_x_center");
        if (ah_sec.contains("initial_y_center")) AH::INITIAL_Y_CENTER = toml::find<std::vector<double>>(ah_sec, "initial_y_center");
        if (ah_sec.contains("initial_z_center")) AH::INITIAL_Z_CENTER = toml::find<std::vector<double>>(ah_sec, "initial_z_center");
        if (ah_sec.contains("ntheta_array")) AH::NTHETA_ARRAY = toml::find<std::vector<int>>(ah_sec, "ntheta_array");
        if (ah_sec.contains("nphi_array")) AH::NPHI_ARRAY = toml::find<std::vector<int>>(ah_sec, "nphi_array");
    }

    if (AH::AH_SOLVER_FREQ > 0) {
{% if enable_bh_tracking %}
        // build simple BH data from BH1/BH2 for the finder
        std::vector<dendro_aeh::SimpleBlackHoleData> simpleBHData = {
            dendro_aeh::SimpleBlackHoleData(
                BH1.getBHCoordX(), BH1.getBHCoordY(), BH1.getBHCoordZ(),
                BH1.getBHMass()),
            dendro_aeh::SimpleBlackHoleData(
                BH2.getBHCoordX(), BH2.getBHCoordY(), BH2.getBHCoordZ(),
                BH2.getBHMass()),
        };
        bool is_bbh = true;
{% else %}
        std::vector<dendro_aeh::SimpleBlackHoleData> simpleBHData;
        bool is_bbh = false;
{% endif %}

        // transform: maps the interpolated evolution vars (AH_INDICES order)
        // to the 12 physical components [gd[6], Kd[6]] BHaHAHA expects.
        auto transform = [](const std::vector<double>& inputs) {
{% if ah_transform_body %}{{ ah_transform_body }}
{% else %}
            // default: BSSN-style (chi, trK, At[6], gt[6])
            std::vector<double> output(12, 0.0);

            const double chi     = inputs[0];
            const double trK_val = inputs[1];
            const double inv_chi = 1.0 / chi;
            const double trK_third = (1.0 / 3.0) * trK_val;

            // gd[ij] = gt[ij] / chi
            for (int i = 0; i < 6; i++)
                output[i] = inputs[8 + i] * inv_chi;

            // Kd[ij] = At[ij] / chi + (1/3) * gd[ij] * trK
            for (int i = 0; i < 6; i++)
                output[6 + i] = inputs[2 + i] * inv_chi + output[i] * trK_third;

            return output;
{% endif %}
        };

        Point grid_limits[2];
        grid_limits[0] = Point({{ project_upper }}_OCTREE_MIN[0],
                               {{ project_upper }}_OCTREE_MIN[1],
                               {{ project_upper }}_OCTREE_MIN[2]);
        grid_limits[1] = Point({{ project_upper }}_OCTREE_MAX[0],
                               {{ project_upper }}_OCTREE_MAX[1],
                               {{ project_upper }}_OCTREE_MAX[2]);

        Point domain_limits[2];
        domain_limits[0] = Point({{ project_upper }}_COMPD_MIN[0],
                                 {{ project_upper }}_COMPD_MIN[1],
                                 {{ project_upper }}_COMPD_MIN[2]);
        domain_limits[1] = Point({{ project_upper }}_COMPD_MAX[0],
                                 {{ project_upper }}_COMPD_MAX[1],
                                 {{ project_upper }}_COMPD_MAX[2]);

        AH::ah_finder = std::make_unique<dendro_aeh::AEH_BHaHAHA>(
            AH::N_HORIZONS, is_bbh,
            AH::INITIAL_X_CENTER, AH::INITIAL_Y_CENTER, AH::INITIAL_Z_CENTER,
            AH::N_RESOLUTIONS_MULTIGRID, AH::M_SCALE, AH::CFL_FACTOR,
            AH::MAX_ITERATIONS, AH::THETA_L2_M_TOL, AH::THETA_LINF_M_TOL,
            AH::ETA_DAMP_M, AH::KO_STRENGTH, AH::MAX_SEARCH_RADIUS,
            AH::NR_INTERP_MAX, AH::NTHETA_MAX, AH::NPHI_MAX, AH::AH_SAVE_DIR,
            simpleBHData, AH::AH_INDICES, transform, grid_limits, domain_limits,
            {{ project_upper }}_IO_OUTPUT_FREQ, AH::NUM_RESOLUTIONS_AFTER_FIND,
            AH::NTHETA_ARRAY, AH::NPHI_ARRAY, AH::ENABLE_ETA_VARYING_ALG,
            AH::VERBOSITY_LEVEL);

        if (rank == 0) {
            std::cout << "Apparent horizon finder initialized ("
                      << AH::N_HORIZONS << " horizons, freq="
                      << AH::AH_SOLVER_FREQ << ")" << std::endl;
        }
    }
#endif
{% endif %}

{% if use_dendro_derivs %}
    // [derivatives] -- see dendrolib's derivs_factory.h for valid type names
    READ_OPTIONAL("derivatives", "type_first", {{ project_upper }}_DERIVTYPE_FIRST);
    READ_OPTIONAL("derivatives", "type_second", {{ project_upper }}_DERIVTYPE_SECOND);
    READ_OPTIONAL("derivatives", "matid_first", {{ project_upper }}_DERIV_FIRST_MATID);
    READ_OPTIONAL("derivatives", "matid_second", {{ project_upper }}_DERIV_SECOND_MATID);
    READ_OPTIONAL("derivatives", "filter_first", {{ project_upper }}_INMATFILT_FIRST);
    READ_OPTIONAL("derivatives", "filter_second", {{ project_upper }}_INMATFILT_SECOND);
    READ_OPTIONAL("derivatives", "post_rhs_filter", {{ project_upper }}_POST_RHS_FILTER);

    {{ project_upper }}_DERIVS = std::make_unique<dendroderivs::DendroDerivatives>(
        {{ project_upper }}_DERIVTYPE_FIRST, {{ project_upper }}_DERIVTYPE_SECOND,
        {{ project_upper }}_ELE_ORDER,
        {{ project_upper }}_DERIV_FIRST_COEFFS, {{ project_upper }}_DERIV_SECOND_COEFFS,
        {{ project_upper }}_DERIV_FIRST_MATID, {{ project_upper }}_DERIV_SECOND_MATID,
        {{ project_upper }}_INMATFILT_FIRST, {{ project_upper }}_INMATFILT_SECOND,
        {{ project_upper }}_INMATFILT_FIRST_COEFFS, {{ project_upper }}_INMATFILT_SECOND_COEFFS,
        {{ project_upper }}_POST_RHS_FILTER);

    if (rank == 0) {
        std::cout << "DendroDerivatives initialized: "
                  << {{ project_upper }}_DERIVS->toString() << std::endl;
    }
{% endif %}

    #undef READ_REQUIRED
    #undef READ_OPTIONAL
    #undef READ_REQUIRED_ARRAY
    #undef READ_OPTIONAL_ARRAY

    if (rank == 0) {
        std::cout << GRN << "Parameter file loaded successfully." << NRM << std::endl;
    }
}

void dumpParamFile(std::ostream& sout, int root, MPI_Comm comm) {
    int rank;
    MPI_Comm_rank(comm, &rank);
    if (rank != root) return;

    // Dumps parsed in-memory values, not the par file, so a silently-kept
    // compiled default is visible in the log.
    const std::streamsize old_prec = sout.precision();
    sout << std::setprecision(17);

    auto arr = [&sout](const char* name, const auto* a, std::size_t n) {
        sout << name << " = [";
        for (std::size_t i = 0; i < n; ++i)
            sout << a[i] << (i + 1 < n ? ", " : "");
        sout << "]" << std::endl;
    };

    sout << "# ==== {{ project_upper }} parameter dump (parsed values, not the par file) ===="
         << std::endl;

    sout << "\n[solver]" << std::endl;
    sout << "dim = " << {{ project_upper }}_DIM << std::endl;
    sout << "ele_order = " << {{ project_upper }}_ELE_ORDER << std::endl;
    sout << "padding_width = " << {{ project_upper }}_PADDING_WIDTH << std::endl;
    sout << "maxdepth = " << {{ project_upper }}_MAXDEPTH << std::endl;
    sout << "mindepth = " << {{ project_upper }}_MINDEPTH << std::endl;
    arr("compd_min", {{ project_upper }}_COMPD_MIN, 3);
    arr("compd_max", {{ project_upper }}_COMPD_MAX, 3);
    arr("octree_min", {{ project_upper }}_OCTREE_MIN, 3);
    arr("octree_max", {{ project_upper }}_OCTREE_MAX, 3);
    sout << "enable_block_adaptivity = " << {{ project_upper }}_ENABLE_BLOCK_ADAPTIVITY
         << std::endl;
    sout << "rk_type = " << {{ project_upper }}_RK_TYPE << std::endl;
    sout << "rk_time_begin = " << {{ project_upper }}_RK_TIME_BEGIN << std::endl;
    sout << "rk_time_end = " << {{ project_upper }}_RK_TIME_END << std::endl;
    sout << "rk45_time_step_size = " << {{ project_upper }}_RK45_TIME_STEP_SIZE << std::endl;
    sout << "rk45_desired_tol = " << {{ project_upper }}_RK45_DESIRED_TOL << std::endl;
    sout << "cfl_factor = " << {{ project_upper }}_CFL_FACTOR << std::endl;
    sout << "io_output_freq = " << {{ project_upper }}_IO_OUTPUT_FREQ << std::endl;
    sout << "time_step_output_freq = " << {{ project_upper }}_TIME_STEP_OUTPUT_FREQ
         << std::endl;
    sout << "checkpt_freq = " << {{ project_upper }}_CHECKPT_FREQ << std::endl;
    sout << "restore_solver = " << {{ project_upper }}_RESTORE_SOLVER << std::endl;
    sout << "dendro_grain_sz = " << {{ project_upper }}_DENDRO_GRAIN_SZ << std::endl;
    sout << "dendro_amr_fac = " << {{ project_upper }}_DENDRO_AMR_FAC << std::endl;
    sout << "load_imb_tol = " << {{ project_upper }}_LOAD_IMB_TOL << std::endl;
    sout << "async_comm_k = " << {{ project_upper }}_ASYNC_COMM_K << std::endl;
    sout << "init_grid_iter = " << {{ project_upper }}_INIT_GRID_ITER << std::endl;
    sout << "remesh_test_freq = " << {{ project_upper }}_REMESH_TEST_FREQ << std::endl;
    sout << "num_refine_vars = " << {{ project_upper }}_NUM_REFINE_VARS << std::endl;

    sout << "\n[refinement]" << std::endl;
    sout << "mode = " << static_cast<unsigned int>({{ project_upper }}_REFINEMENT_MODE)
         << "   # 0=WAMR 1=EH 2=EH_WAMR 3=BH_LOC 4=BH_WAMR" << std::endl;
    sout << "wavelet_tol = " << {{ project_upper }}_WAVELET_TOL << std::endl;
    sout << "wavelet_tol_max = " << {{ project_upper }}_WAVELET_TOL_MAX << std::endl;
    sout << "use_wavelet_tol_function = " << {{ project_upper }}_USE_WAVELET_TOL_FUNCTION
         << std::endl;
    sout << "wavelet_tol_function_r0 = " << {{ project_upper }}_WAVELET_TOL_FUNCTION_R0
         << std::endl;
    sout << "wavelet_tol_function_r1 = " << {{ project_upper }}_WAVELET_TOL_FUNCTION_R1
         << std::endl;
    sout << "amr_r_ratio = " << {{ project_upper }}_AMR_R_RATIO << std::endl;

    sout << "\n[dissipation]" << std::endl;
    sout << "ko_diss_sigma = " << KO_DISS_SIGMA << std::endl;
    sout << "use_const_ko = " << USE_CONST_KO << std::endl;
    sout << "dissipation_type = " << DISSIPATION_TYPE << std::endl;

{% if use_dendro_derivs %}
    sout << "\n[derivatives]" << std::endl;
    sout << "type_first = \"" << {{ project_upper }}_DERIVTYPE_FIRST << "\"" << std::endl;
    sout << "type_second = \"" << {{ project_upper }}_DERIVTYPE_SECOND << "\"" << std::endl;
{% endif %}

    // [physics]: generated from the equation config's ParameterVariables, so a
    // system's own parameters appear here without touching this template.
    sout << "\n[physics]" << std::endl;
{% for pvar in physics_params | default([]) %}
{% if pvar.num_params > 1 %}
    arr("{{ pvar.toml_key }}", {{ pvar.cpp_var }}, {{ pvar.num_params }});
{% else %}
    sout << "{{ pvar.toml_key }} = " << {{ pvar.cpp_var }} << std::endl;
{% endif %}
{% if pvar.description and not pvar.description.startswith("Parameter: ") %}
    sout << "#   {{ pvar.description | replace('"', "'") }}" << std::endl;
{% endif %}
{% endfor %}
{% for vname in pos_floor_vars | default(['chi', 'alpha']) %}
    sout << "{{ vname | lower }}_floor = " << {{ vname | upper }}_FLOOR << std::endl;
{% endfor %}

    sout << "\n[initial_data]" << std::endl;
    sout << "id_type = " << {{ project_upper }}_ID_TYPE;
{% for idt in initial_data_types | default([]) %}
    if ({{ project_upper }}_ID_TYPE == {{ idt.id }})
        sout << "   # {{ idt.name | replace('"', "'") }}{% if idt.note %} -- {{ idt.note | replace('"', "'") }}{% endif %}";
{% endfor %}
    sout << std::endl;

{% if enable_bh_tracking %}
    for (int b = 0; b < 2; ++b) {
        const double cr =
            (b == 0) ? {{ project_upper }}_BH1_CONSTRAINT_R : {{ project_upper }}_BH2_CONSTRAINT_R;
        sout << "\n[bh" << (b + 1) << "]" << std::endl;
        sout << "loc = [" << {{ project_upper }}_BH_LOC[b].x() << ", "
             << {{ project_upper }}_BH_LOC[b].y() << ", "
             << {{ project_upper }}_BH_LOC[b].z() << "]" << std::endl;
        sout << "max_lev = "
             << ((b == 0) ? {{ project_upper }}_BH1_MAX_LEV : {{ project_upper }}_BH2_MAX_LEV)
             << std::endl;
        sout << "amr_r = "
             << ((b == 0) ? {{ project_upper }}_BH1_AMR_R : {{ project_upper }}_BH2_AMR_R)
             << std::endl;
        sout << "constraint_r = " << cr;
        if (cr <= 0.0)
            sout << "   # 0 = norms include the puncture; BSSN uses 1.0, so rms"
                    " is not comparable to a BSSN log";
        sout << std::endl;
    }
{% endif %}

    sout << "\n# ==== end parameter dump ====" << std::endl;
    sout << std::setprecision(old_prec);
}

