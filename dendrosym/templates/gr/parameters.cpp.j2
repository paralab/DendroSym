{% if enable_bh_tracking %}
        // build simple BH data from BH1/BH2 for the finder
        std::vector<dendro_aeh::SimpleBlackHoleData> simpleBHData = {
            dendro_aeh::SimpleBlackHoleData(
                BH1.getBHCoordX(), BH1.getBHCoordY(), BH1.getBHCoordZ(),
                BH1.getBHMass()),
            dendro_aeh::SimpleBlackHoleData(
                BH2.getBHCoordX(), BH2.getBHCoordY(), BH2.getBHCoordZ(),
