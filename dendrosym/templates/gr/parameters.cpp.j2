// =========================================================================
// TOML Parameter Reading
// =========================================================================

namespace {{ namespace }} {

namespace {

// Helper: try to find a key in a TOML table section first, then fall back
// to the top-level table. This lets users organize params into sections
// while staying backward-compatible with flat key files.
template <typename T>
bool try_read(const toml::value& root, const std::string& section,
              const std::string& key, T& out) {
    // 1) Try [section].key
    if (root.contains(section)) {
        const auto& tbl = root.at(section);
        if (tbl.contains(key)) {
            out = toml::find<T>(tbl, key);
            return true;
        }
    }
    // 2) Try top-level key (flat format)
    if (root.contains(key)) {
        out = toml::find<T>(root, key);
        return true;
    }
    // 3) Try legacy format: "namespace::KEY"
    std::string legacy = "{{ namespace }}::" + key;
    if (root.contains(legacy)) {
        out = toml::find<T>(root, legacy);
        return true;
    }
    // Also try with project prefix
    std::string prefixed = "{{ project_upper }}_" + key;
    if (root.contains(prefixed)) {
        out = toml::find<T>(root, prefixed);
        return true;
    }
    return false;
}

// Overload for C arrays
template <typename T, std::size_t N>
bool try_read_array(const toml::value& root, const std::string& section,
                    const std::string& key, T (&out)[N]) {
    std::vector<T> vec;

    // Try section, then flat, then legacy
    bool found = false;
    if (root.contains(section)) {
        const auto& tbl = root.at(section);
        if (tbl.contains(key)) {
            vec = toml::find<std::vector<T>>(tbl, key);
            found = true;
        }
    }
    if (!found && root.contains(key)) {
        vec = toml::find<std::vector<T>>(root, key);
        found = true;
    }
    if (!found) {
        std::string legacy = "{{ namespace }}::" + key;
        if (root.contains(legacy)) {
            vec = toml::find<std::vector<T>>(root, legacy);
            found = true;
        }
    }
    if (!found) {
        std::string prefixed = "{{ project_upper }}_" + key;
        if (root.contains(prefixed)) {
            vec = toml::find<std::vector<T>>(root, prefixed);
            found = true;
        }
    }

    if (found && vec.size() >= N) {
        for (std::size_t i = 0; i < N; ++i) out[i] = vec[i];
        return true;
    }
    return found;
}

}  // anonymous namespace

void readParamFile(const char* inFile, MPI_Comm comm) {
    int rank, npes;
    MPI_Comm_rank(comm, &rank);
    MPI_Comm_size(comm, &npes);

    const auto root = toml::parse(inFile);

    // Macro for required params: fail if not found
    #define READ_REQUIRED(section, key, var) \
        if (!try_read(root, section, key, var)) { \
            if (rank == 0) std::cerr << RED << "MISSING REQUIRED PARAMETER: " \
                << "[" << section << "] " << key << NRM << std::endl; \
            throw std::runtime_error("Missing required parameter: " + \
                                     std::string(key)); \
        }

    // Macro for optional params: warn if not found, keep default
    #define READ_OPTIONAL(section, key, var) \
        if (!try_read(root, section, key, var)) { \
            if (rank == 0) std::cout << YLW << "\tOptional param '" << key \
                << "' not found, using default" << NRM << std::endl; \
        }

    #define READ_REQUIRED_ARRAY(section, key, var) \
        if (!try_read_array(root, section, key, var)) { \
            if (rank == 0) std::cerr << RED << "MISSING REQUIRED ARRAY: " \
                << "[" << section << "] " << key << NRM << std::endl; \
            throw std::runtime_error("Missing required array: " + \
                                     std::string(key)); \
        }

    #define READ_OPTIONAL_ARRAY(section, key, var) \
        try_read_array(root, section, key, var)

    // =================================================================
    // [solver] - Mesh and time stepping
    // =================================================================
    READ_REQUIRED("solver", "maxdepth", {{ project_upper }}_MAXDEPTH);
    READ_REQUIRED("solver", "dim", {{ project_upper }}_DIM);
    READ_REQUIRED("solver", "rk_type", {{ project_upper }}_RK_TYPE);
    READ_REQUIRED("solver", "rk_time_begin", {{ project_upper }}_RK_TIME_BEGIN);
    READ_REQUIRED("solver", "rk_time_end", {{ project_upper }}_RK_TIME_END);
    READ_REQUIRED("solver", "rk45_time_step_size", {{ project_upper }}_RK45_TIME_STEP_SIZE);
    READ_REQUIRED("solver", "rk45_desired_tol", {{ project_upper }}_RK45_DESIRED_TOL);
    READ_REQUIRED("solver", "io_output_freq", {{ project_upper }}_IO_OUTPUT_FREQ);
    READ_REQUIRED("solver", "remesh_test_freq", {{ project_upper }}_REMESH_TEST_FREQ);
    READ_REQUIRED("solver", "checkpt_freq", {{ project_upper }}_CHECKPT_FREQ);
    READ_REQUIRED("solver", "vtu_file_prefix", {{ project_upper }}_VTU_FILE_PREFIX);
    READ_REQUIRED("solver", "chkpt_file_prefix", {{ project_upper }}_CHKPT_FILE_PREFIX);
    READ_REQUIRED("solver", "profile_file_prefix", {{ project_upper }}_PROFILE_FILE_PREFIX);
    READ_REQUIRED("solver", "restore_solver", {{ project_upper }}_RESTORE_SOLVER);
    READ_REQUIRED("solver", "dendro_grain_sz", {{ project_upper }}_DENDRO_GRAIN_SZ);
    READ_REQUIRED("solver", "async_comm_k", {{ project_upper }}_ASYNC_COMM_K);
    READ_REQUIRED("solver", "dendro_amr_fac", {{ project_upper }}_DENDRO_AMR_FAC);
    READ_REQUIRED("solver", "load_imb_tol", {{ project_upper }}_LOAD_IMB_TOL);

    READ_OPTIONAL("solver", "ele_order", {{ project_upper }}_ELE_ORDER);
    READ_OPTIONAL("solver", "mindepth", {{ project_upper }}_MINDEPTH);
    READ_OPTIONAL("solver", "enable_block_adaptivity",
                  {{ project_upper }}_ENABLE_BLOCK_ADAPTIVITY);
    READ_OPTIONAL("solver", "blk_min_x", {{ project_upper }}_BLK_MIN_X);
    READ_OPTIONAL("solver", "blk_min_y", {{ project_upper }}_BLK_MIN_Y);
    READ_OPTIONAL("solver", "blk_min_z", {{ project_upper }}_BLK_MIN_Z);
    READ_OPTIONAL("solver", "blk_max_x", {{ project_upper }}_BLK_MAX_X);
    READ_OPTIONAL("solver", "blk_max_y", {{ project_upper }}_BLK_MAX_Y);
    READ_OPTIONAL("solver", "blk_max_z", {{ project_upper }}_BLK_MAX_Z);
    READ_OPTIONAL("solver", "cfl_factor", {{ project_upper }}_CFL_FACTOR);
    READ_OPTIONAL("solver", "init_grid_iter", {{ project_upper }}_INIT_GRID_ITER);
    READ_OPTIONAL("solver", "time_step_output_freq", {{ project_upper }}_TIME_STEP_OUTPUT_FREQ);
    READ_OPTIONAL("solver", "num_refine_vars", {{ project_upper }}_NUM_REFINE_VARS);
    READ_OPTIONAL("solver", "num_evol_vars_vtu_output", {{ project_upper }}_NUM_EVOL_VARS_VTU_OUTPUT);
    READ_OPTIONAL("solver", "num_const_vars_vtu_output", {{ project_upper }}_NUM_CONST_VARS_VTU_OUTPUT);
    READ_OPTIONAL("solver", "vtu_x_slice", {{ project_upper }}_VTU_X_SLICE);
    READ_OPTIONAL("solver", "vtu_y_slice", {{ project_upper }}_VTU_Y_SLICE);
    READ_OPTIONAL("solver", "vtu_z_slice", {{ project_upper }}_VTU_Z_SLICE);

    READ_REQUIRED_ARRAY("solver", "compd_min", {{ project_upper }}_COMPD_MIN);
    READ_REQUIRED_ARRAY("solver", "compd_max", {{ project_upper }}_COMPD_MAX);
    READ_OPTIONAL_ARRAY("solver", "octree_min", {{ project_upper }}_OCTREE_MIN);
    // recompute OCTREE_MAX from the toml-loaded MAXDEPTH (static init used the
    // declared default); READ_OPTIONAL_ARRAY below overrides if user set it
    {{ project_upper }}_OCTREE_MAX[0] = (double)(1u << {{ project_upper }}_MAXDEPTH);
    {{ project_upper }}_OCTREE_MAX[1] = (double)(1u << {{ project_upper }}_MAXDEPTH);
    {{ project_upper }}_OCTREE_MAX[2] = (double)(1u << {{ project_upper }}_MAXDEPTH);
    READ_OPTIONAL_ARRAY("solver", "octree_max", {{ project_upper }}_OCTREE_MAX);

    // recompute dependent values
    {{ project_upper }}_PADDING_WIDTH = {{ project_upper }}_ELE_ORDER >> 1u;
    {{ project_upper }}_CURRENT_MIN_DX = ({{ project_upper }}_COMPD_MAX[0] - {{ project_upper }}_COMPD_MIN[0]) *
                                         (1.0 / (double)(1u << {{ project_upper }}_MAXDEPTH));

    // =================================================================
    // [refinement]
    // =================================================================
    READ_OPTIONAL("refinement", "wavelet_tol", {{ project_upper }}_WAVELET_TOL);
    READ_OPTIONAL("refinement", "wavelet_tol_max", {{ project_upper }}_WAVELET_TOL_MAX);
    READ_OPTIONAL("refinement", "use_wavelet_tol_function", {{ project_upper }}_USE_WAVELET_TOL_FUNCTION);
    READ_OPTIONAL("refinement", "wavelet_tol_function_r0", {{ project_upper }}_WAVELET_TOL_FUNCTION_R0);
    READ_OPTIONAL("refinement", "wavelet_tol_function_r1", {{ project_upper }}_WAVELET_TOL_FUNCTION_R1);

    // =================================================================
    // [dissipation]
    // =================================================================
    READ_REQUIRED("dissipation", "ko_diss_sigma", KO_DISS_SIGMA);
    READ_OPTIONAL("dissipation", "use_const_ko", USE_CONST_KO);
    READ_OPTIONAL("dissipation", "dissipation_type", DISSIPATION_TYPE);

    // =================================================================
    // [physics] - Equation-specific parameters
    // These are read with their short names (no project prefix)
    // =================================================================
{% for pvar in physics_params | default([]) %}
{% if pvar.num_params > 1 %}
    READ_OPTIONAL_ARRAY("physics", "{{ pvar.toml_key }}", {{ pvar.cpp_var }});
{% else %}
    READ_OPTIONAL("physics", "{{ pvar.toml_key }}", {{ pvar.cpp_var }});
{% endif %}
{% endfor %}

    // =================================================================
    // [initial_data]
    // =================================================================
    READ_OPTIONAL("initial_data", "id_type", {{ project_upper }}_ID_TYPE);

{% if enable_bh_tracking %}
    // read BH parameters from [bh1] and [bh2] sections
    {
