                                 {{ project_upper }}_COMPD_MAX[1],
                                 {{ project_upper }}_COMPD_MAX[2]);

        AH::ah_finder = std::make_unique<dendro_aeh::AEH_BHaHAHA>(
            AH::N_HORIZONS, is_bbh,
            AH::INITIAL_X_CENTER, AH::INITIAL_Y_CENTER, AH::INITIAL_Z_CENTER,
            AH::N_RESOLUTIONS_MULTIGRID, AH::M_SCALE, AH::CFL_FACTOR,
            AH::MAX_ITERATIONS, AH::THETA_L2_M_TOL, AH::THETA_LINF_M_TOL,
            AH::ETA_DAMP_M, AH::KO_STRENGTH, AH::MAX_SEARCH_RADIUS,
            AH::NR_INTERP_MAX, AH::NTHETA_MAX, AH::NPHI_MAX, AH::AH_SAVE_DIR,
            simpleBHData, AH::AH_INDICES, transform, grid_limits, domain_limits,
            {{ project_upper }}_IO_OUTPUT_FREQ, AH::NUM_RESOLUTIONS_AFTER_FIND,
            AH::NTHETA_ARRAY, AH::NPHI_ARRAY, AH::ENABLE_ETA_VARYING_ALG,
            AH::VERBOSITY_LEVEL);

        if (rank == 0) {
            std::cout << "Apparent horizon finder initialized ("
                      << AH::N_HORIZONS << " horizons, freq="
                      << AH::AH_SOLVER_FREQ << ")" << std::endl;
        }
    }
#endif
