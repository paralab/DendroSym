void {{ project_upper }}Ctx::findAH() {
#ifdef SOLVER_ENABLE_AH
    if (!m_uiMesh->isActive()) return;
    if (AH::ah_finder == nullptr) return;

    DVec &m_evar = m_var[VL::CPU_EV];

    // ghost exchange and unzip
    m_uiMesh->readFromGhostBegin(m_evar.get_vec_ptr(), m_evar.get_dof());
    m_uiMesh->readFromGhostEnd(m_evar.get_vec_ptr(), m_evar.get_dof());
    this->unzip(m_evar, m_var[VL::CPU_EV_UZ_IN], {{ project_upper }}_ASYNC_COMM_K);

    DendroScalar *eVar[{{ evolution_num_vars }}];
    m_evar.to_2d(eVar);

    // build list of BH locations to search near
    std::vector<Point> bh_locations;
{% if enable_bh_tracking %}
    bh_locations.push_back(m_uiBHLoc[0]);
    bh_locations.push_back(m_uiBHLoc[1]);
{% endif %}

    AH::ah_finder->find_horizons(m_uiMesh, (const double **)eVar,
                                  m_uiTinfo._m_uiStep, m_uiTinfo._m_uiT,
                                  bh_locations);
#endif
}
{% endif %}

