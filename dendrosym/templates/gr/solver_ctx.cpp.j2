int {{ project_upper }}Ctx::rhs(DVec *in, DVec *out, unsigned int sz,
                                DendroScalar time) {
    // Unzip evolution vars for stencil computation
    m_uiMesh->readFromGhostBegin(in->GetVecArray(),
                                  in->GetDof());
    m_uiMesh->readFromGhostEnd(in->GetVecArray(),
                                in->GetDof());

    m_uiMesh->unzip(in->GetVecArray(),
                     m_var[VL::CPU_EV_UZ_IN].GetVecArray(),
                     in->GetDof());

{% if constraint_num_vars > 0 %}
    // Unzip constraint vars (if needed by RHS, e.g., CAHD)
    m_uiMesh->readFromGhostBegin(m_var[VL::CPU_CV].GetVecArray(),
                                  {{ constraint_num_vars }});
    m_uiMesh->readFromGhostEnd(m_var[VL::CPU_CV].GetVecArray(),
                                {{ constraint_num_vars }});
    m_uiMesh->unzip(m_var[VL::CPU_CV].GetVecArray(),
                     m_var[VL::CPU_CV_UZ_IN].GetVecArray(),
                     {{ constraint_num_vars }});
{% endif %}

    const ot::Block *blkList = &(*(m_uiMesh->getLocalBlockList().begin()));
    const unsigned int numBlocks = m_uiMesh->getLocalBlockList().size();

    // Call the generated RHS
    {{ project_name }}RHS(
        (double **)m_var[VL::CPU_EV_UZ_OUT].GetVecArray(),
        (const double **)m_var[VL::CPU_EV_UZ_IN].GetVecArray(),
        blkList, numBlocks, time,
{% if constraint_num_vars > 0 %}
        (const double **)m_var[VL::CPU_CV_UZ_IN].GetVecArray()
{% else %}
        nullptr
{% endif %}
    );

    // Zip output back
    m_uiMesh->zip(m_var[VL::CPU_EV_UZ_OUT].GetVecArray(),
                   out->GetVecArray(), out->GetDof());

    return 0;
}

