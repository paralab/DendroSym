int {{ project_upper }}Ctx::init_grid() {
    if (!m_uiMesh->isActive()) return 0;

    DVec &m_evar = m_var[VL::CPU_EV];

    const ot::TreeNode *pNodes = &(*(m_uiMesh->getAllElements().begin()));
    const unsigned int eleOrder = m_uiMesh->getElementOrder();
    const unsigned int *e2n_cg = &(*(m_uiMesh->getE2NMapping().begin()));
    const unsigned int *e2n_dg = &(*(m_uiMesh->getE2NMapping_DG().begin()));
    const unsigned int nPe = m_uiMesh->getNumNodesPerElement();
    const unsigned int nodeLocalBegin = m_uiMesh->getNodeLocalBegin();
    const unsigned int nodeLocalEnd = m_uiMesh->getNodeLocalEnd();

    DendroScalar *zipIn[{{ evolution_num_vars }}];
    m_evar.to_2d(zipIn);

{% if enable_tpid %}
    // two-punctures: do the elliptic solve first (collective, all ranks)
    double mp, mm, mp_adm, mm_adm, E, J1, J2, J3;
    double var1[{{ evolution_num_vars }}];
    if ({{ project_upper }}_ID_TYPE == 0) {
        TP_MPI_COMM = m_uiMesh->getMPIGlobalCommunicator();
        TwoPunctures(0.0, 0.0, 0.0, var1, &mp, &mm, &mp_adm, &mm_adm,
                     &E, &J1, &J2, &J3);
    }
{% endif %}

    for (unsigned int elem = m_uiMesh->getElementLocalBegin();
         elem < m_uiMesh->getElementLocalEnd(); elem++) {

        DendroScalar var[{{ evolution_num_vars }}];

        for (unsigned int k = 0; k < (eleOrder + 1); k++)
            for (unsigned int j = 0; j < (eleOrder + 1); j++)
                for (unsigned int i = 0; i < (eleOrder + 1); i++) {

                    const unsigned int nodeLookUp_CG =
                        e2n_cg[elem * nPe +
                               k * (eleOrder + 1) * (eleOrder + 1) +
                               j * (eleOrder + 1) + i];

                    if (nodeLookUp_CG >= nodeLocalBegin &&
                        nodeLookUp_CG < nodeLocalEnd) {

                        const unsigned int nodeLookUp_DG =
                            e2n_dg[elem * nPe +
                                   k * (eleOrder + 1) * (eleOrder + 1) +
                                   j * (eleOrder + 1) + i];

                        unsigned int ownerID, ii_x, jj_y, kk_z;
                        m_uiMesh->dg2eijk(nodeLookUp_DG, ownerID, ii_x, jj_y, kk_z);

                        const DendroScalar len =
                            (double)(1u << (m_uiMaxDepth - pNodes[ownerID].getLevel()));
                        const DendroScalar x =
                            pNodes[ownerID].getX() + ii_x * (len / eleOrder);
                        const DendroScalar y =
                            pNodes[ownerID].getY() + jj_y * (len / eleOrder);
                        const DendroScalar z =
                            pNodes[ownerID].getZ() + kk_z * (len / eleOrder);

{% if enable_tpid %}
                        if ({{ project_upper }}_ID_TYPE == 0) {
                            // tp solver: interpolate the stored solution
                            TwoPunctures(
                                (double)GRIDX_TO_X(x), (double)GRIDY_TO_Y(y),
                                (double)GRIDZ_TO_Z(z), var,
                                &mp, &mm, &mp_adm, &mm_adm, &E, &J1, &J2, &J3);
                        } else {
                            initDataFuncToPhysCoords((double)x, (double)y, (double)z, var);
                        }
{% else %}
                        initDataFuncToPhysCoords((double)x, (double)y, (double)z, var);
{% endif %}

                        for (unsigned int v = 0; v < {{ evolution_num_vars }}; v++)
                            zipIn[v][nodeLookUp_CG] = var[v];
                    }
                }
    }

    // enforce evolution constraints on initial data
    for (unsigned int node = nodeLocalBegin; node < nodeLocalEnd; node++) {
        enforce_{{ project_name }}_constraints(zipIn, node);
    }

    return 0;
}

// =========================================================================
// rhs -- unzip, call generated equations, zip back
// =========================================================================

int {{ project_upper }}Ctx::rhs(DVec *in, DVec *out, unsigned int sz,
                                DendroScalar time) {

    {{ namespace }}::timer::t_unzip_async.start();
    this->unzip(*in, m_var[VL::CPU_EV_UZ_IN], {{ project_upper }}_ASYNC_COMM_K);
    {{ namespace }}::timer::t_unzip_async.stop();

    DendroScalar *unzipIn[{{ evolution_num_vars }}];
    DendroScalar *unzipOut[{{ evolution_num_vars }}];

    m_var[CPU_EV_UZ_IN].to_2d(unzipIn);
    m_var[CPU_EV_UZ_OUT].to_2d(unzipOut);

    const ot::Block *blkList = m_uiMesh->getLocalBlockList().data();
    const unsigned int numBlocks = m_uiMesh->getLocalBlockList().size();

{% if constraint_num_vars > 0 %}
    DendroScalar *unzipConsIn[{{ constraint_num_vars }}];
    m_var[CPU_CV_UZ_IN].to_2d(unzipConsIn);
{% endif %}

    {{ project_name }}RHS(
        unzipOut, (const double **)unzipIn,
        blkList, numBlocks, time,
{% if constraint_num_vars > 0 %}
        (const double **)unzipConsIn
{% else %}
        nullptr
{% endif %}
    );

    {{ namespace }}::timer::t_zip.start();
    this->zip(m_var[CPU_EV_UZ_OUT], *out);
    {{ namespace }}::timer::t_zip.stop();

    return 0;
}

