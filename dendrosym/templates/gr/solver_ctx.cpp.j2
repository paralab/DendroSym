// =========================================================================
// Remeshing
// =========================================================================

bool {{ project_upper }}Ctx::is_remesh() {
    if ({{ project_upper }}_REFINEMENT_MODE == REFINE_MODE_NONE) return false;

    bool isRemesh = false;

    if ({{ project_upper }}_REFINEMENT_MODE == WAMR ||
        {{ project_upper }}_REFINEMENT_MODE == EH_WAMR ||
        {{ project_upper }}_REFINEMENT_MODE == BH_WAMR) {

        DendroScalar *varData[{{ evolution_num_vars }}];
        m_var[VL::CPU_EV].Get2DArray(varData, false);

        const DendroScalar *refineVars[{{ project_upper }}_NUM_REFINE_VARS];
        for (unsigned int i = 0; i < {{ project_upper }}_NUM_REFINE_VARS; i++) {
            refineVars[i] = varData[{{ project_upper }}_REFINE_VARIABLE_INDICES[i]];
        }

        double amr_fac = m_bIsBHMerged ? {{ project_upper }}_DENDRO_AMR_FAC
                                        : {{ project_upper }}_DENDRO_AMR_FAC;

        isRemesh = m_uiMesh->isReMeshUnzip(
            (const DendroScalar **)refineVars,
            {{ project_upper }}_NUM_REFINE_VARS,
            {{ project_upper }}_WAVELET_TOL,
            amr_fac);
    }

    return isRemesh;
}

int {{ project_upper }}Ctx::grid_transfer(const ot::Mesh *m_new) {
    // Transfer evolution variables to new mesh
    m_var[VL::CPU_EV].GridTransfer(m_uiMesh, m_new);
{% if constraint_num_vars > 0 %}
    m_var[VL::CPU_CV].GridTransfer(m_uiMesh, m_new);
{% endif %}

    // Update mesh pointer (base class)
    m_uiMesh = (ot::Mesh *)m_new;

    // Reallocate unzipped vectors
    m_var[VL::CPU_EV_UZ_IN].VecDestroy();
    m_var[VL::CPU_EV_UZ_OUT].VecDestroy();
    m_var[VL::CPU_EV_UZ_IN].VecCreateUnzip(m_uiMesh, {{ evolution_num_vars }});
    m_var[VL::CPU_EV_UZ_OUT].VecCreateUnzip(m_uiMesh, {{ evolution_num_vars }});
{% if constraint_num_vars > 0 %}
    m_var[VL::CPU_CV_UZ_IN].VecDestroy();
    m_var[VL::CPU_CV_UZ_IN].VecCreateUnzip(m_uiMesh, {{ constraint_num_vars }});
{% endif %}

    // Reallocate derivative workspace
    if ({{ project_upper }}_DERIV_WORKSPACE != nullptr) {
        delete[] {{ project_upper }}_DERIV_WORKSPACE;
    }
    const unsigned int unzipSz = m_uiMesh->getDegOfFreedomUnZip();
    {{ project_upper }}_DERIV_WORKSPACE =
        new double[{{ project_upper }}_NUM_DERIVATIVES * unzipSz];

    return 0;
}

void {{ project_upper }}Ctx::calculate_full_grid_size() {
    DendroIntL localElements = m_uiMesh->getNumLocalMeshElements();
    DendroIntL localNodes = m_uiMesh->getNumLocalMeshNodes();

    par::Mpi_Reduce(&localElements, &m_uiGlobalMeshElements, 1,
                     MPI_SUM, 0, m_uiMesh->getMPIGlobalCommunicator());
    par::Mpi_Reduce(&localNodes, &m_uiGlobalGridPoints, 1,
                     MPI_SUM, 0, m_uiMesh->getMPIGlobalCommunicator());
}

