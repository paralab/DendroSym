void {{ project_upper }}Ctx::compute_constraint_variables() {
{% if constraint_num_vars > 0 %}
    if (!m_uiMesh->isActive()) return;

    // Unzip evolution vars
    m_uiMesh->readFromGhostBegin(m_var[VL::CPU_EV].GetVecArray(),
                                  {{ evolution_num_vars }});
    m_uiMesh->readFromGhostEnd(m_var[VL::CPU_EV].GetVecArray(),
                                {{ evolution_num_vars }});
    m_uiMesh->unzip(m_var[VL::CPU_EV].GetVecArray(),
                     m_var[VL::CPU_EV_UZ_IN].GetVecArray(),
                     {{ evolution_num_vars }});

    const ot::Block *blkList = &(*(m_uiMesh->getLocalBlockList().begin()));
    const unsigned int numBlocks = m_uiMesh->getLocalBlockList().size();

    {{ project_name }}Constraints(
        (double **)m_var[VL::CPU_CV_UZ_IN].GetVecArray(),
        (const double **)m_var[VL::CPU_EV_UZ_IN].GetVecArray(),
        blkList, numBlocks);

    // Zip constraints back
    m_uiMesh->zip(m_var[VL::CPU_CV_UZ_IN].GetVecArray(),
                   m_var[VL::CPU_CV].GetVecArray(),
                   {{ constraint_num_vars }});

    m_uiMesh->readFromGhostBegin(m_var[VL::CPU_CV].GetVecArray(),
                                  {{ constraint_num_vars }});
    m_uiMesh->readFromGhostEnd(m_var[VL::CPU_CV].GetVecArray(),
                                {{ constraint_num_vars }});

    m_bConstraintsComputed = true;
{% endif %}
}

