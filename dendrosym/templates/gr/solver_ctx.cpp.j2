// =========================================================================
// Initialization
// =========================================================================

int {{ project_upper }}Ctx::initialize() {
    if ({{ project_upper }}_RESTORE_SOLVER) {
        restore_checkpt();
        return 0;
    }

    // Iterative mesh refinement: evaluate initial data, remesh, repeat
    // until the grid converges
    unsigned int iter = 0;
    const unsigned int max_iter = {{ project_upper }}_INIT_GRID_ITER;

    do {
        init_grid();

        // Check if mesh needs refinement based on initial data
        if (!is_remesh()) break;

        // Perform remesh
        ot::Mesh *newMesh = m_uiMesh->ReMesh({{ project_upper }}_WAVELET_TOL);
        if (newMesh == m_uiMesh) break;  // No change

        grid_transfer(newMesh);
        iter++;

    } while (iter < max_iter);

    init_grid();  // Final evaluation on converged mesh
    return 0;
}

int {{ project_upper }}Ctx::init_grid() {
    if (!m_uiMesh->isActive()) return 0;

    const unsigned int dof = {{ evolution_num_vars }};
    DendroScalar *zipIn[dof];
    m_var[VL::CPU_EV].Get2DArray(zipIn, false);

    const ot::TreeNode *pNodes = &(*(m_uiMesh->getAllElements().begin()));
    const unsigned int eleOrder = m_uiMesh->getElementOrder();
    const unsigned int *e2n_cg = &(*(m_uiMesh->getE2NMapping().begin()));
    const unsigned int *e2n_dg = &(*(m_uiMesh->getE2NMapping_DG().begin()));
    const unsigned int nPe = m_uiMesh->getNumNodesPerElement();
    const unsigned int nodeLocalBegin = m_uiMesh->getNodeLocalBegin();
    const unsigned int nodeLocalEnd = m_uiMesh->getNodeLocalEnd();

    const double pt_min[3] = { {{ project_upper }}_COMPD_MIN[0],
                               {{ project_upper }}_COMPD_MIN[1],
                               {{ project_upper }}_COMPD_MIN[2] };
    const double pt_max[3] = { {{ project_upper }}_COMPD_MAX[0],
                               {{ project_upper }}_COMPD_MAX[1],
                               {{ project_upper }}_COMPD_MAX[2] };

    double var[dof];

    for (unsigned int elem = m_uiMesh->getElementLocalBegin();
         elem < m_uiMesh->getElementLocalEnd(); elem++) {

        for (unsigned int k = 0; k < (eleOrder + 1); k++)
            for (unsigned int j = 0; j < (eleOrder + 1); j++)
                for (unsigned int i = 0; i < (eleOrder + 1); i++) {

                    const unsigned int nodeLookUp_CG =
                        e2n_cg[elem * nPe +
                               k * (eleOrder + 1) * (eleOrder + 1) +
                               j * (eleOrder + 1) + i];

                    if (nodeLookUp_CG >= nodeLocalBegin &&
                        nodeLookUp_CG < nodeLocalEnd) {

                        const unsigned int nodeLookUp_DG =
                            e2n_dg[elem * nPe +
                                   k * (eleOrder + 1) * (eleOrder + 1) +
                                   j * (eleOrder + 1) + i];

                        double x, y, z;
                        m_uiMesh->dg2ecoord(nodeLookUp_DG, x, y, z);

                        // Convert grid coords to physical coords
                        const double xx = GRIDX_TO_X(x);
                        const double yy = GRIDY_TO_Y(y);
                        const double zz = GRIDZ_TO_Z(z);

                        initDataFuncToPhysCoords(xx, yy, zz, var);

                        for (unsigned int v = 0; v < dof; v++) {
                            zipIn[v][nodeLookUp_CG] = var[v];
                        }
                    }
                }
    }

    // Enforce evolution constraints on initial data
    for (unsigned int node = nodeLocalBegin; node < nodeLocalEnd; node++) {
        enforce_{{ project_name }}_constraints(zipIn, node);
    }

    return 0;
}

