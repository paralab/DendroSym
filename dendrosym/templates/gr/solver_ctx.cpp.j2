int {{ project_upper }}Ctx::extract_gravitational_waves() {
{% if constraint_num_vars > 0 %}
    if (!m_uiMesh->isActive()) return 0;

    // make sure constraints (including Psi4) are computed
    this->compute_constraint_variables();

    DendroScalar *consVar[{{ constraint_num_vars }}];
    m_var[VL::CPU_CV].to_2d(consVar);

    // build the extraction config from our parameters
    dendro_gr::GWExtractionConfig gw_config;
    gw_config.psi4_real_idx = VAR_CONSTRAINT::C_PSI4_REAL;
    gw_config.psi4_imag_idx = VAR_CONSTRAINT::C_PSI4_IMAG;
    gw_config.file_prefix = {{ project_upper }}_PROFILE_FILE_PREFIX;
    for (unsigned int i = 0; i < GW::{{ project_upper }}_GW_NUM_RADAII; i++)
        gw_config.radii.push_back(GW::{{ project_upper }}_GW_RADAII[i]);
    for (unsigned int i = 0; i < GW::{{ project_upper }}_GW_NUM_LMODES; i++)
        gw_config.l_modes.push_back(GW::{{ project_upper }}_GW_L_MODES[i]);
    for (int i = 0; i < 3; i++) {
        gw_config.compd_min[i] = {{ project_upper }}_COMPD_MIN[i];
        gw_config.compd_max[i] = {{ project_upper }}_COMPD_MAX[i];
        gw_config.octree_min[i] = {{ project_upper }}_OCTREE_MIN[i];
        gw_config.octree_max[i] = {{ project_upper }}_OCTREE_MAX[i];
    }

    dendro_gr::extractFarFieldPsi4(m_uiMesh, (const DendroScalar **)consVar,
                                    m_uiTinfo._m_uiStep, m_uiTinfo._m_uiT,
                                    gw_config);
{% endif %}
    return 0;
}
