int {{ project_upper }}Ctx::write_vtu() {
    if (!m_uiMesh->isActive()) return 0;

    DendroScalar *evolVar[{{ evolution_num_vars }}];
    m_var[VL::CPU_EV].to_2d(evolVar);

{% if constraint_num_vars > 0 %}
    this->compute_constraint_variables();
    DendroScalar *consVar[{{ constraint_num_vars }}];
    m_var[VL::CPU_CV].to_2d(consVar);
{% endif %}

{% if enable_analytical %}
    this->compute_analytical();
    DendroScalar *analyticVar[{{ evolution_num_vars }}];
    DendroScalar *analyticDiffVar[{{ evolution_num_vars }}];
    m_var[VL::CPU_ANALYTIC].to_2d(analyticVar);
    m_var[VL::CPU_ANALYTIC_DIFF].to_2d(analyticDiffVar);
{% endif %}

    // build the list of data arrays and names for VTU output
    std::vector<std::string> pDataNames;
    std::vector<double *> pDataVec;

    const unsigned int numEvolVars = {{ project_upper }}_NUM_EVOL_VARS_VTU_OUTPUT;
{% if constraint_num_vars > 0 %}
    const unsigned int numConstVars = {{ project_upper }}_NUM_CONST_VARS_VTU_OUTPUT;
{% else %}
    const unsigned int numConstVars = 0;
{% endif %}

    // evolution variables
    for (unsigned int i = 0; i < numEvolVars; i++) {
        pDataNames.push_back(std::string(
            {{ project_upper }}_VAR_NAMES[{{ project_upper }}_VTU_OUTPUT_EVOL_INDICES[i]]));
        pDataVec.push_back(evolVar[{{ project_upper }}_VTU_OUTPUT_EVOL_INDICES[i]]);
    }

{% if constraint_num_vars > 0 %}
    // constraint variables
    for (unsigned int i = 0; i < numConstVars; i++) {
        pDataNames.push_back(std::string(
            {{ project_upper }}_VAR_CONSTRAINT_NAMES[{{ project_upper }}_VTU_OUTPUT_CONST_INDICES[i]]));
        pDataVec.push_back(consVar[{{ project_upper }}_VTU_OUTPUT_CONST_INDICES[i]]);
    }
{% endif %}

{% if enable_analytical %}
    // analytical + diff
    for (unsigned int i = 0; i < numEvolVars; i++) {
        unsigned int idx = {{ project_upper }}_VTU_OUTPUT_EVOL_INDICES[i];
        pDataNames.push_back(std::string({{ project_upper }}_VAR_NAMES[idx]) + "_ANLYT");
        pDataVec.push_back(analyticVar[idx]);
    }
    for (unsigned int i = 0; i < numEvolVars; i++) {
        unsigned int idx = {{ project_upper }}_VTU_OUTPUT_EVOL_INDICES[i];
        pDataNames.push_back(std::string({{ project_upper }}_VAR_NAMES[idx]) + "_DIFF");
        pDataVec.push_back(analyticDiffVar[idx]);
    }
{% endif %}

    // convert to char* array for the vtk api
    std::vector<const char *> pDataNames_char;
    for (auto &s : pDataNames) pDataNames_char.push_back(s.c_str());

    const char *fDataNames[] = {"Time", "Cycle"};
    const double fData[] = {m_uiTinfo._m_uiT, (double)m_uiTinfo._m_uiStep};

    char fPrefix[256];
    sprintf(fPrefix, "%s_%06d", {{ project_upper }}_VTU_FILE_PREFIX.c_str(),
            m_uiTinfo._m_uiStep);

    // if any slice flag is set, emit a 2D slice via mesh2vtu_slice (matches
    // BSSN_GR). plane goes through the octree center; first true flag wins.
    // all flags false -> full 3D output.
    const bool slice_x = {{ namespace }}::{{ project_upper }}_VTU_X_SLICE;
    const bool slice_y = {{ namespace }}::{{ project_upper }}_VTU_Y_SLICE;
    const bool slice_z = {{ namespace }}::{{ project_upper }}_VTU_Z_SLICE;

    if (slice_x || slice_y || slice_z) {
        const unsigned int center = 1u << (m_uiMaxDepth - 1);
        unsigned int s_val[3] = {center, center, center};
        unsigned int s_norm[3] = {0, 0, 0};
        if      (slice_x) s_norm[0] = 1;
        else if (slice_y) s_norm[1] = 1;
        else              s_norm[2] = 1;

        io::vtk::mesh2vtu_slice(
            m_uiMesh, s_val, s_norm, fPrefix, 2, fDataNames, fData,
            (unsigned int)pDataVec.size(),
            pDataNames_char.data(),
            (const double **)pDataVec.data());
    } else {
        io::vtk::mesh2vtuFine(
            m_uiMesh, fPrefix, 2, fDataNames, fData,
            (unsigned int)pDataVec.size(),
            pDataNames_char.data(),
            (const double **)pDataVec.data());
    }

    return 0;
}

int {{ project_upper }}Ctx::terminal_output() {
    if (!m_uiMesh->isActive()) return 0;

    const int rank = m_uiMesh->getMPIRank();
    const MPI_Comm comm = m_uiMesh->getMPICommunicator();
    const unsigned int nLocal = m_uiMesh->getNumLocalMeshNodes();
    const unsigned int nodeBegin = m_uiMesh->getNodeLocalBegin();

    if (rank == 0) {
        std::cout << "[{{ project_upper }}] step=" << m_uiTinfo._m_uiStep
                  << " t=" << m_uiTinfo._m_uiT
                  << " dt=" << m_uiTinfo._m_uiTh
                  << " elements=" << m_uiGlobalMeshElements
                  << std::endl;
    }

    // Report per-node + volume-averaged RMS deviation from flat space,
    // sqrt(int (u - u_flat)^2 dV / V): the per-point departure from the
    // background, O(amp) and grid-independent. Only the variables listed in
    // {{ project_upper }}_TERMINAL_OUTPUT_* are computed -- each needs a ghost
    // exchange, so narrow those in the par to cut synchronization.
    const size_t dof = m_uiMesh->getDegOfFreedom();
    const auto& termEvolSel = {{ project_upper }}_TERMINAL_OUTPUT_EVOL_INDICES;
    const auto& termConsSel = {{ project_upper }}_TERMINAL_OUTPUT_CONST_INDICES;

    // u_flat per var (reference IC is homogeneous -> one eval). Unset -> 0.
    double flat_ref[{{ evolution_num_vars }}];
    for (unsigned int v = 0; v < {{ evolution_num_vars }}; v++) flat_ref[v] = 0.0;
    DendroScalar *zippedUp[{{ evolution_num_vars }}];
    m_var[VL::CPU_EV].to_2d(zippedUp);

    double invMeshVolume = 0.0;
    if (!termEvolSel.empty() || !termConsSel.empty()) {
{% if flat_reference_function %}
        {{ flat_reference_function }}(0.0, 0.0, 0.0, flat_ref);
{% endif %}
        // V = int 1 dV (works for AMR and uniform grids)
        std::vector<double> onesVec;
        m_uiMesh->createVector(onesVec);
        for (size_t i = 0; i < dof; i++) onesVec[i] = 1.0;
        const double meshVolume =
            integrateScalarFieldOnMesh(m_uiMesh, onesVec.data());
        invMeshVolume = (meshVolume > 0.0) ? (1.0 / meshVolume) : 0.0;
    }

    if (!termEvolSel.empty()) {
        std::vector<double> devVec;
        m_uiMesh->createVector(devVec);
        for (unsigned int v : termEvolSel) {
            if (v >= {{ evolution_num_vars }}) continue;
            double l_min = vecMin(&zippedUp[v][nodeBegin], nLocal, comm);
            double l_max = vecMax(&zippedUp[v][nodeBegin], nLocal, comm);
            for (size_t i = 0; i < dof; i++) devVec[i] = zippedUp[v][i] - flat_ref[v];
            // rms = per-node RMS; rms_vol = volume-weighted (AMR-aware)
            double rms = normRMSE(&devVec[nodeBegin], nLocal, comm);
            double rms_vol = std::sqrt(
                calculateL2FullMeshIntegration(m_uiMesh, devVec.data()) * invMeshVolume);
            if (rank == 0) {
                std::cout << "\t[var]:  " << std::setw(12)
                          << {{ project_upper }}_VAR_NAMES[v]
                          << " (min, max, rms_dev, rms_dev_vol) : \t ( "
                          << l_min << ", " << l_max << ", " << rms << ", "
                          << rms_vol << ") "
                          << std::endl;
            }
        }
    }

{% if enable_analytical %}
    // compute and print analytical solution error norms
    this->compute_analytical();

    DendroScalar *zippedDiff[{{ evolution_num_vars }}];
    m_var[VL::CPU_ANALYTIC_DIFF].to_2d(zippedDiff);

    // write csv header on first step
    char fName[256];
    sprintf(fName, "%s_ANALYTICAL_DIFF.csv", {{ project_upper }}_PROFILE_FILE_PREFIX.c_str());

    if (rank == 0 && m_uiTinfo._m_uiStep == 0) {
        std::ofstream fileDiff(fName, std::ofstream::trunc);
        fileDiff << "Timestep,Time,";
        for (unsigned int v = 0; v < {{ evolution_num_vars }}; v++) {
            std::string name = {{ project_upper }}_VAR_NAMES[v];
            fileDiff << name << "_DIFF_MIN," << name << "_DIFF_MAX,"
                     << name << "_DIFF_L2," << name << "_DIFF_RMSE,"
                     << name << "_DIFF_NRMSE," << name << "_DIFF_MAE,";
        }
        fileDiff << std::endl;
        fileDiff.close();
    }

    // compute and print per-variable error norms
    if (rank == 0) {
        std::ofstream fileDiff(fName, std::ofstream::app);
        fileDiff << m_uiTinfo._m_uiStep << "," << m_uiTinfo._m_uiT << ",";

        for (unsigned int v = 0; v < {{ evolution_num_vars }}; v++) {
            double l_min = vecMin(&zippedDiff[v][nodeBegin], nLocal, comm);
            double l_max = vecMax(&zippedDiff[v][nodeBegin], nLocal, comm);
            double l2 = normL2(&zippedDiff[v][nodeBegin], nLocal, comm);
            double rmse = normRMSE(&zippedDiff[v][nodeBegin], nLocal, comm);
            double nrmse = normNRMSE(&zippedDiff[v][nodeBegin],
                                      &zippedUp[v][nodeBegin], nLocal, comm);
            double mae = normMAE(&zippedDiff[v][nodeBegin], nLocal, comm);

            std::cout << "\t[diff]: " << std::setw(12)
                      << std::string({{ project_upper }}_VAR_NAMES[v]) + "_DIFF"
                      << " (min, max, l2, rmse, nrmse, mae) : \t ( "
                      << l_min << ", " << l_max << ", " << l2 << ", "
                      << rmse << ", " << nrmse << ", " << mae << ") "
                      << std::endl;

            fileDiff << l_min << "," << l_max << "," << l2 << ","
                     << rmse << "," << nrmse << "," << mae << ",";
        }
        fileDiff << std::endl;
        fileDiff.close();
    }
{% endif %}

{% if constraint_num_vars > 0 %}
    // constraint norms -- only computed if any are selected (the constraint
    // computation itself is expensive, so this skips it entirely otherwise)
    if (!termConsSel.empty()) {
        this->compute_constraint_variables();

        DendroScalar *zippedCons[{{ constraint_num_vars }}];
        m_var[VL::CPU_CV].to_2d(zippedCons);

{% if enable_bh_tracking %}
        // Optional puncture excision for the constraint norms. Nodes within
        // BH<n>_CONSTRAINT_R of a puncture are dropped from the *masked*
        // norms. Both radii default to 0 -> mask inactive -> the unmasked
        // norms below are reported exactly as before.
        //
        // Why this exists: BSSN's constraint norm
        // (BSSN_GR/include/grUtils.tcc, computeConstraintL2Norm) excises a
        // ball of radius BSSN_BH1_CONSTRAINT_R (production value 1.0) around
        // each puncture, and it *must* -- BSSN's Hamiltonian constraint is
        // non-finite at a puncture, so the unmasked norm is NaN. Our norms
        // include the puncture, where essentially all of the violation lives.
        // Comparing the two logs directly is therefore meaningless; setting
        // constraint_r to BSSN's value makes rms_msk a like-for-like number.
        const double bh1_cr = {{ namespace }}::{{ project_upper }}_BH1_CONSTRAINT_R;
        const double bh2_cr = {{ namespace }}::{{ project_upper }}_BH2_CONSTRAINT_R;
        const bool maskActive = (bh1_cr > 0.0 || bh2_cr > 0.0);

        std::vector<double> consMask;
        if (maskActive) {
            // 1.0 = keep, 0.0 = excised. Built over the whole dof range; only
            // the local slice is used below, so shared nodes can be written
            // more than once without double counting.
            consMask.resize(dof, 1.0);

            const ot::TreeNode *pNodes = m_uiMesh->getAllElements().data();
            const unsigned int *e2n_cg = &(*(m_uiMesh->getE2NMapping().begin()));
            const unsigned int *e2n_dg = &(*(m_uiMesh->getE2NMapping_DG().begin()));
            const unsigned int eleOrder = m_uiMesh->getElementOrder();
            const unsigned int nPe = m_uiMesh->getNumNodesPerElement();
            const unsigned int nodeLocalEnd = m_uiMesh->getNodeLocalEnd();

            for (unsigned int elem = m_uiMesh->getElementLocalBegin();
                 elem < m_uiMesh->getElementLocalEnd(); elem++) {
                for (unsigned int k = 0; k < (eleOrder + 1); k++)
                    for (unsigned int j = 0; j < (eleOrder + 1); j++)
                        for (unsigned int i = 0; i < (eleOrder + 1); i++) {
                            const unsigned int nIdx =
                                k * (eleOrder + 1) * (eleOrder + 1) +
                                j * (eleOrder + 1) + i;
                            const unsigned int nodeLookUp_CG =
                                e2n_cg[elem * nPe + nIdx];
                            if (nodeLookUp_CG < nodeBegin ||
                                nodeLookUp_CG >= nodeLocalEnd)
                                continue;

                            const unsigned int nodeLookUp_DG =
                                e2n_dg[elem * nPe + nIdx];
                            unsigned int ownerID, ii_x, jj_y, kk_z;
                            m_uiMesh->dg2eijk(nodeLookUp_DG, ownerID, ii_x,
                                              jj_y, kk_z);

                            const double len = (double)(1u << (m_uiMaxDepth -
                                pNodes[ownerID].getLevel()));
                            const double xo =
                                pNodes[ownerID].getX() + ii_x * (len / eleOrder);
                            const double yo =
                                pNodes[ownerID].getY() + jj_y * (len / eleOrder);
                            const double zo =
                                pNodes[ownerID].getZ() + kk_z * (len / eleOrder);

                            const Point gp(GRIDX_TO_X(xo), GRIDY_TO_Y(yo),
                                           GRIDZ_TO_Z(zo));
                            const double d1 =
                                (gp - {{ namespace }}::{{ project_upper }}_BH_LOC[0]).abs();
                            const double d2 =
                                (gp - {{ namespace }}::{{ project_upper }}_BH_LOC[1]).abs();
                            if (d1 < bh1_cr || d2 < bh2_cr)
                                consMask[nodeLookUp_CG] = 0.0;
                        }
            }
        }
{% endif %}

        // At a 2:1 jump the fine side comes from degree-(eleOrder)
        // prolongation; a second derivative divides that by h^2, leaving those
        // DOFs one order short of the interior scheme. rms_int drops them.
        // Conservative: drops the whole element, not just the stencil radius.
        std::vector<double> ifaceMask(dof, 1.0);
        {
            const ot::TreeNode *pN = m_uiMesh->getAllElements().data();
            const unsigned int *e2n = &(*(m_uiMesh->getE2NMapping().begin()));
            const unsigned int *e2e = &(*(m_uiMesh->getE2EMapping().begin()));
            const unsigned int nDir = m_uiMesh->getNumDirections();
            const unsigned int nPe_ = m_uiMesh->getNumNodesPerElement();
            const unsigned int nEnd = m_uiMesh->getNodeLocalEnd();

            // all elements, not just local: a node owned here can belong to a
            // jump-adjacent element owned by another rank
            for (unsigned int elem = m_uiMesh->getElementPreGhostBegin();
                 elem < m_uiMesh->getElementPostGhostEnd(); elem++) {
                const unsigned int lev = pN[elem].getLevel();
                bool nearJump = false;
                for (unsigned int d = 0; d < nDir && !nearJump; d++) {
                    const unsigned int nb = e2e[elem * nDir + d];
                    if (nb != LOOK_UP_TABLE_DEFAULT &&
                        pN[nb].getLevel() != lev)
                        nearJump = true;
                }
                if (!nearJump) continue;
                for (unsigned int n = 0; n < nPe_; n++) {
                    const unsigned int nd = e2n[elem * nPe_ + n];
                    if (nd >= nodeBegin && nd < nEnd) ifaceMask[nd] = 0.0;
                }
            }
        }

        // constraints -> 0 in the continuum, so RMS is the violation directly
        for (unsigned int v : termConsSel) {
            if (v >= {{ constraint_num_vars }}) continue;
            double l_min = vecMin(&zippedCons[v][nodeBegin], nLocal, comm);
            double l_max = vecMax(&zippedCons[v][nodeBegin], nLocal, comm);
            double rms = normRMSE(&zippedCons[v][nodeBegin], nLocal, comm);
            double rms_vol =
                std::sqrt(calculateL2FullMeshIntegration(m_uiMesh, zippedCons[v]) *
                          invMeshVolume);

{% if enable_bh_tracking %}
            // sqrt(sum c^2 / N) over kept nodes -- same formula as normRMSE
            // and as BSSN's computeConstraintL2Norm, just over the kept set.
            double rms_msk = rms;
            if (maskActive) {
                double l_acc[2] = {0.0, 0.0};  // {sum c^2, kept-node count}
                for (unsigned int n = 0; n < nLocal; n++) {
                    if (consMask[nodeBegin + n] == 0.0) continue;
                    const double c = zippedCons[v][nodeBegin + n];
                    l_acc[0] += c * c;
                    l_acc[1] += 1.0;
                }
                double g_acc[2] = {0.0, 0.0};
                MPI_Allreduce(l_acc, g_acc, 2, MPI_DOUBLE, MPI_SUM, comm);
                rms_msk = (g_acc[1] > 0.0)
                              ? std::sqrt(g_acc[0] / g_acc[1])
                              : 0.0;
            }
{% endif %}

            // same formula again, additionally dropping the interface collar
            double rms_int = 0.0;
            {
                double l_acc[2] = {0.0, 0.0};
                for (unsigned int n = 0; n < nLocal; n++) {
                    if (ifaceMask[nodeBegin + n] == 0.0) continue;
{% if enable_bh_tracking %}
                    if (maskActive && consMask[nodeBegin + n] == 0.0) continue;
{% endif %}
                    const double c = zippedCons[v][nodeBegin + n];
                    l_acc[0] += c * c;
                    l_acc[1] += 1.0;
                }
                double g_acc[2] = {0.0, 0.0};
                MPI_Allreduce(l_acc, g_acc, 2, MPI_DOUBLE, MPI_SUM, comm);
                rms_int = (g_acc[1] > 0.0)
                              ? std::sqrt(g_acc[0] / g_acc[1])
                              : 0.0;
            }

            if (rank == 0) {
                std::cout << "\t[con]:  " << std::setw(12)
                          << {{ project_upper }}_VAR_CONSTRAINT_NAMES[v]
{% if enable_bh_tracking %}
                          << " (min, max, rms, rms_vol, rms_msk, rms_int) : \t ( "
                          << l_min << ", " << l_max << ", " << rms << ", "
                          << rms_vol << ", " << rms_msk << ", " << rms_int << ") "
{% else %}
                          << " (min, max, rms, rms_vol, rms_int) : \t ( "
                          << l_min << ", " << l_max << ", " << rms << ", "
                          << rms_vol << ", " << rms_int << ") "
{% endif %}
                          << std::endl;
            }
        }
    }
{% endif %}

    return 0;
}

void {{ project_upper }}Ctx::write_grid_summary_data() {
    calculate_full_grid_size();
}

// =========================================================================
// remeshing
// =========================================================================

bool {{ project_upper }}Ctx::is_remesh() {
    if ({{ project_upper }}_REFINEMENT_MODE == REFINE_MODE_NONE) return false;

    auto run_wamr = [this]() {
        this->unzip(m_var[VL::CPU_EV], m_var[VL::CPU_EV_UZ_IN],
                    {{ project_upper }}_ASYNC_COMM_K);
        DendroScalar *unzipVar[{{ evolution_num_vars }}];
        m_var[VL::CPU_EV_UZ_IN].to_2d(unzipVar);
        std::function<double(double, double, double, double *)> wtolFn =
            [](double x, double y, double z, double *hx) {
                return computeWTolDCoords(x, y, z, hx);
            };
        return m_uiMesh->isReMeshUnzip(
            (const DendroScalar **)unzipVar,
            {{ project_upper }}_REFINE_VARIABLE_INDICES,
            {{ project_upper }}_NUM_REFINE_VARS,
            wtolFn,
            {{ project_upper }}_DENDRO_AMR_FAC);
    };

{% if enable_bh_tracking %}
    auto run_bh_loc = [this](bool overwrite) {
        dendro_gr::BHLocCfg cfg;
        // Only refine around active BHs; an inert (mass-0) puncture must not
        // build a phantom onion. No-op for a real binary (both > tol).
        constexpr double BH_ACTIVE_MASS_TOL = 1.0e-6;
        if (BH1.getBHMass() > BH_ACTIVE_MASS_TOL) {
            cfg.bh_locations.push_back(m_uiBHLoc[0]);
            cfg.bh_amr_radii.push_back({{ project_upper }}_BH1_AMR_R);
            cfg.bh_max_levels.push_back({{ project_upper }}_BH1_MAX_LEV);
        }
        if (BH2.getBHMass() > BH_ACTIVE_MASS_TOL) {
            cfg.bh_locations.push_back(m_uiBHLoc[1]);
            cfg.bh_amr_radii.push_back({{ project_upper }}_BH2_AMR_R);
            cfg.bh_max_levels.push_back({{ project_upper }}_BH2_MAX_LEV);
        }
        cfg.ratio         = {{ project_upper }}_AMR_R_RATIO;
        cfg.min_level     = {{ project_upper }}_MINDEPTH;
        cfg.overwrite     = overwrite;
        return dendro_gr::isRemeshBH(m_uiMesh, cfg);
    };

    switch ({{ project_upper }}_REFINEMENT_MODE) {
        case WAMR:    return run_wamr();
        case BH_LOC:  return run_bh_loc(/*overwrite=*/true);
        case BH_WAMR: {
            const bool r1 = run_wamr();
            const bool r2 = run_bh_loc(/*overwrite=*/false);
            return r1 || r2;
        }
        default: return run_wamr();  // EH/EH_WAMR not yet ported
    }
{% else %}
    return run_wamr();
{% endif %}
}

int {{ project_upper }}Ctx::grid_transfer(const ot::Mesh *m_new) {
    // dealloc old MPI context
    ot::dealloc_mpi_ctx<DendroScalar>(m_uiMesh, m_mpi_ctx, {{ evolution_num_vars }},
                                       {{ project_upper }}_ASYNC_COMM_K);

    // transfer evolution variables to the new mesh (interpolation)
    DVec::grid_transfer(m_uiMesh, m_new, m_var[VL::CPU_EV]);

    // destroy everything that depends on the old mesh layout
{% if constraint_num_vars > 0 %}
    m_var[VL::CPU_CV].destroy_vector();
    m_var[VL::CPU_CV_UZ_IN].destroy_vector();
{% endif %}
    m_var[VL::CPU_EV_UZ_IN].destroy_vector();
    m_var[VL::CPU_EV_UZ_OUT].destroy_vector();
{% if enable_analytical %}
    m_var[VL::CPU_ANALYTIC].destroy_vector();
    m_var[VL::CPU_ANALYTIC_DIFF].destroy_vector();
{% endif %}

    // reallocate on the new mesh
    // note: the base class swaps m_uiMesh after this returns, so use m_new
    m_var[VL::CPU_EV_UZ_IN].create_vector(m_new,
        ot::DVEC_TYPE::OCT_LOCAL_WITH_PADDING, ot::DVEC_LOC::HOST,
        {{ evolution_num_vars }}, true);
    m_var[VL::CPU_EV_UZ_OUT].create_vector(m_new,
        ot::DVEC_TYPE::OCT_LOCAL_WITH_PADDING, ot::DVEC_LOC::HOST,
        {{ evolution_num_vars }}, true);
{% if constraint_num_vars > 0 %}
    m_var[VL::CPU_CV].create_vector(m_new, ot::DVEC_TYPE::OCT_SHARED_NODES,
        ot::DVEC_LOC::HOST, {{ constraint_num_vars }}, true);
    m_var[VL::CPU_CV_UZ_IN].create_vector(m_new,
        ot::DVEC_TYPE::OCT_LOCAL_WITH_PADDING, ot::DVEC_LOC::HOST,
        {{ constraint_num_vars }}, true);
{% endif %}
{% if enable_analytical %}
    m_var[VL::CPU_ANALYTIC].create_vector(m_new, ot::DVEC_TYPE::OCT_SHARED_NODES,
        ot::DVEC_LOC::HOST, {{ evolution_num_vars }}, true);
    m_var[VL::CPU_ANALYTIC_DIFF].create_vector(m_new, ot::DVEC_TYPE::OCT_SHARED_NODES,
        ot::DVEC_LOC::HOST, {{ evolution_num_vars }}, true);
{% endif %}

    // alloc MPI context on new mesh
    ot::alloc_mpi_ctx<DendroScalar>(m_new, m_mpi_ctx, {{ evolution_num_vars }},
                                     {{ project_upper }}_ASYNC_COMM_K);

    return 0;
}

void {{ project_upper }}Ctx::calculate_full_grid_size() {
    DendroIntL localElements = m_uiMesh->getNumLocalMeshElements();
    DendroIntL localNodes = m_uiMesh->getNumLocalMeshNodes();

    par::Mpi_Reduce(&localElements, &m_uiGlobalMeshElements, 1,
                     MPI_SUM, 0, m_uiMesh->getMPIGlobalCommunicator());
    par::Mpi_Reduce(&localNodes, &m_uiGlobalGridPoints, 1,
                     MPI_SUM, 0, m_uiMesh->getMPIGlobalCommunicator());
}

// =========================================================================
// checkpointing
//
// Two alternating slots (0/1) for crash safety, plus a `<prefix>.latest`
// sentinel written LAST via an atomic rename: a crash mid-write never advances
// it, so restore always lands on the last *fully complete* checkpoint. The
// metadata is a single self-describing, versioned JSON file -- adding new state
// is one line in write_checkpt() + one defaulted line in restore_checkpt().
// The heavy mesh/variable data uses dendrolib's binary io::checkpoint helpers.
// =========================================================================

// checkpoint layout version -- bump only on an incompatible format change.
static const unsigned int {{ project_upper }}_CHKPT_FORMAT_VERSION = 1;

int {{ project_upper }}Ctx::write_checkpt() {
    if (!m_uiMesh->isActive()) return 0;

    const unsigned int rank = m_uiMesh->getMPIRank();
    const unsigned int slot =
        (m_uiTinfo._m_uiStep / {{ project_upper }}_CHECKPT_FREQ) % 2;

    char fname[512];

    // (1) octree topology -- one binary file per (active) rank
    const ot::TreeNode *pNodes = &(*(m_uiMesh->getAllElements().begin() +
                                     m_uiMesh->getElementLocalBegin()));
    sprintf(fname, "%s_%u_octree_%u.oct",
            {{ project_upper }}_CHKPT_FILE_PREFIX.c_str(), slot, rank);
    io::checkpoint::writeOctToFile(fname, pNodes,
                                   m_uiMesh->getNumLocalMeshElements());

    // (2) evolution variables -- one binary file per (active) rank
    DendroScalar *eVar[{{ evolution_num_vars }}];
    m_var[VL::CPU_EV].to_2d(eVar);
    sprintf(fname, "%s_%u_vars_%u.var",
            {{ project_upper }}_CHKPT_FILE_PREFIX.c_str(), slot, rank);
    io::checkpoint::writeVecToFile(fname, m_uiMesh, (const DendroScalar **)eVar,
                                   {{ evolution_num_vars }});

    // (3) self-describing metadata -- single JSON file (active rank 0)
    if (rank == 0) {
        json meta;
        meta["format_version"] = {{ project_upper }}_CHKPT_FORMAT_VERSION;
        meta["num_evol_vars"]  = {{ evolution_num_vars }};
        // element order from the mesh (authoritative; m_uiElementOrder is not
        // guaranteed initialized in the ctx).
        meta["ele_order"]      = m_uiMesh->getElementOrder();
        meta["active_comm_sz"] = m_uiMesh->getMPICommSize();
        meta["time"]["tb"]     = m_uiTinfo._m_uiTb;
        meta["time"]["te"]     = m_uiTinfo._m_uiTe;
        meta["time"]["t"]      = m_uiTinfo._m_uiT;
        meta["time"]["step"]   = m_uiTinfo._m_uiStep;
        meta["time"]["dt"]     = m_uiTinfo._m_uiTh;
        meta["wavelet_tol"]    = {{ project_upper }}_WAVELET_TOL;
        meta["load_imb_tol"]   = {{ project_upper }}_LOAD_IMB_TOL;
{% if enable_bh_tracking %}
        meta["bh"]["loc"] = json::array({
            json::array({m_uiBHLoc[0].x(), m_uiBHLoc[0].y(), m_uiBHLoc[0].z()}),
            json::array({m_uiBHLoc[1].x(), m_uiBHLoc[1].y(), m_uiBHLoc[1].z()})});
        meta["bh"]["merged"]     = m_bIsBHMerged;
        meta["bh"]["merge_time"] = m_dMergeTime;
        meta["bh"]["merge_step"] = m_uiMergeStep;
        // BH location/time history -> flat double vectors -> base91 (compact,
        // self-describing length; mirrors dendro_bh::BHHistory::encode).
        std::vector<double> locHist;
        locHist.reserve(m_uiBHLocHistory.size() * 6);
        for (const auto &p : m_uiBHLocHistory) {
            locHist.push_back(p.first.x());
            locHist.push_back(p.first.y());
            locHist.push_back(p.first.z());
            locHist.push_back(p.second.x());
            locHist.push_back(p.second.y());
            locHist.push_back(p.second.z());
        }
        meta["bh"]["loc_history_b91"]  = dendro_aeh::b91_encode(locHist);
        meta["bh"]["time_history_b91"] = dendro_aeh::b91_encode(m_uiBHTimeHistory);
{% endif %}
        sprintf(fname, "%s_%u.meta.json",
                {{ project_upper }}_CHKPT_FILE_PREFIX.c_str(), slot);
        std::ofstream mf(fname);
        mf << std::setw(2) << meta << std::endl;
        mf.close();
    }

    // (4) sentinel: barrier so every active rank's .oct/.var/.meta is flushed,
    //     then rank 0 atomically publishes which slot is now complete + valid.
    MPI_Barrier(m_uiMesh->getMPICommunicator());
    if (rank == 0) {
        json latest;
        latest["format_version"] = {{ project_upper }}_CHKPT_FORMAT_VERSION;
        latest["slot"]           = slot;
        latest["step"]           = (uint64_t)m_uiTinfo._m_uiStep;
        char tmpf[512], finalf[512];
        sprintf(tmpf, "%s.latest.tmp",
                {{ project_upper }}_CHKPT_FILE_PREFIX.c_str());
        sprintf(finalf, "%s.latest", {{ project_upper }}_CHKPT_FILE_PREFIX.c_str());
        std::ofstream lf(tmpf);
        lf << latest << std::endl;
        lf.close();
        std::filesystem::rename(tmpf, finalf);  // atomic publish
        std::cout << "[{{ project_name }}] checkpoint written: slot " << slot
                  << " step " << m_uiTinfo._m_uiStep
                  << " t=" << m_uiTinfo._m_uiT << std::endl;
    }
    return 0;
}

int {{ project_upper }}Ctx::restore_checkpt() {
    MPI_Comm comm = m_uiMesh->getMPIGlobalCommunicator();
    int rank, npes;
    MPI_Comm_rank(comm, &rank);
    MPI_Comm_size(comm, &npes);

    // (1) rank 0 reads the sentinel to find the last complete slot; broadcast.
    int slot = -1;
    if (rank == 0) {
        char lname[512];
        sprintf(lname, "%s.latest", {{ project_upper }}_CHKPT_FILE_PREFIX.c_str());
        if (std::filesystem::exists(lname)) {
            std::ifstream lf(lname);
            json latest;
            lf >> latest;
            slot = latest.value("slot", -1);
        }
    }
    par::Mpi_Bcast(&slot, 1, 0, comm);

    if (slot < 0) {
        if (!rank)
            std::cout << "[{{ project_name }}] no valid checkpoint ("
                      << {{ project_upper }}_CHKPT_FILE_PREFIX
                      << ".latest missing) -- starting from initial data."
                      << std::endl;
        init_grid();
        return 0;
    }

    // (2) every rank reads the (small) self-describing metadata for that slot.
    char fname[512];
    sprintf(fname, "%s_%d.meta.json",
            {{ project_upper }}_CHKPT_FILE_PREFIX.c_str(), slot);
    json meta;
    {
        std::ifstream mf(fname);
        if (!mf) {
            if (!rank)
                std::cerr << "[{{ project_name }}] checkpoint metadata missing: "
                          << fname << std::endl;
            MPI_Abort(comm, 0);
        }
        mf >> meta;
    }

    const unsigned int file_nvars = meta.value("num_evol_vars", 0u);
    if (file_nvars != {{ evolution_num_vars }}) {
        if (!rank)
            std::cerr << "[{{ project_name }}] checkpoint var-count mismatch: file="
                      << file_nvars << " expected=" << {{ evolution_num_vars }}
                      << std::endl;
        MPI_Abort(comm, 0);
    }
    const unsigned int active_comm_sz = meta["active_comm_sz"];
    // element order from the checkpoint (the ctx's m_uiElementOrder may be
    // unset here; the metadata value is authoritative for rebuilding the mesh).
    const unsigned int ele_order = meta["ele_order"].get<unsigned int>();

    // restore time-stepper state (the ETS pulls this via get_ts_info()).
    m_uiTinfo._m_uiTb   = meta["time"]["tb"].get<double>();
    m_uiTinfo._m_uiTe   = meta["time"]["te"].get<double>();
    m_uiTinfo._m_uiT    = meta["time"]["t"].get<double>();
    m_uiTinfo._m_uiStep = meta["time"]["step"].get<unsigned int>();
    m_uiTinfo._m_uiTh   = meta["time"]["dt"].get<double>();

{% if enable_bh_tracking %}
    if (meta.contains("bh")) {
        const auto &bh = meta["bh"];
        m_uiBHLoc[0] = Point(bh["loc"][0][0].get<double>(),
                             bh["loc"][0][1].get<double>(),
                             bh["loc"][0][2].get<double>());
        m_uiBHLoc[1] = Point(bh["loc"][1][0].get<double>(),
                             bh["loc"][1][1].get<double>(),
                             bh["loc"][1][2].get<double>());
        {{ project_upper }}_BH_LOC[0] = m_uiBHLoc[0];
        {{ project_upper }}_BH_LOC[1] = m_uiBHLoc[1];
        m_bIsBHMerged = bh.value("merged", false);
        m_dMergeTime  = bh.value("merge_time",
                                 std::numeric_limits<double>::max());
        m_uiMergeStep = bh.value("merge_step",
                                 std::numeric_limits<uint32_t>::max());
        m_uiBHLocHistory.clear();
        m_uiBHTimeHistory.clear();
        if (bh.contains("loc_history_b91") && bh.contains("time_history_b91")) {
            std::vector<double> lh = dendro_aeh::b91_decode<double>(
                bh["loc_history_b91"].get<std::string>());
            std::vector<double> th = dendro_aeh::b91_decode<double>(
                bh["time_history_b91"].get<std::string>());
            for (size_t i = 0; i + 5 < lh.size(); i += 6)
                m_uiBHLocHistory.push_back(std::make_pair(
                    Point(lh[i], lh[i + 1], lh[i + 2]),
                    Point(lh[i + 3], lh[i + 4], lh[i + 5])));
            m_uiBHTimeHistory.assign(th.begin(), th.end());
        }
    }
{% endif %}

    if (active_comm_sz > (unsigned int)npes) {
        if (!rank)
            std::cerr << "[{{ project_name }}] checkpoint was written with "
                      << active_comm_sz << " active ranks; cannot restore on "
                      << npes << " (communicator shrinking unsupported)."
                      << std::endl;
        MPI_Abort(comm, 0);
    }

    // (3) active ranks read their octree slice (file index = active rank).
    const bool isActive = ((unsigned int)rank < active_comm_sz);
    MPI_Comm activeComm;
    par::splitComm2way(!isActive, &activeComm, comm);

    std::vector<ot::TreeNode> octree;
    int readStatus = 0, readStatusG = 0;
    if (isActive) {
        int activeRank;
        MPI_Comm_rank(activeComm, &activeRank);
        sprintf(fname, "%s_%d_octree_%d.oct",
                {{ project_upper }}_CHKPT_FILE_PREFIX.c_str(), slot, activeRank);
        readStatus = io::checkpoint::readOctFromFile(fname, octree);
    }
    par::Mpi_Allreduce(&readStatus, &readStatusG, 1, MPI_MAX, comm);
    if (readStatusG != 0) {
        if (!rank)
            std::cerr << "[{{ project_name }}] checkpoint octree (.oct) read "
                         "failed/corrupt." << std::endl;
        MPI_Abort(comm, 0);
    }

    // (4) rebuild the mesh from the restored octree.
    ot::Mesh *newMesh =
        new ot::Mesh(octree, 1, ele_order, active_comm_sz, comm);
    newMesh->setDomainBounds(
        Point({{ project_upper }}_GRID_MIN_X, {{ project_upper }}_GRID_MIN_Y,
              {{ project_upper }}_GRID_MIN_Z),
        Point({{ project_upper }}_GRID_MAX_X, {{ project_upper }}_GRID_MAX_Y,
              {{ project_upper }}_GRID_MAX_Z));

    // (5) move every mesh-sized allocation onto the new mesh.
    ot::dealloc_mpi_ctx<DendroScalar>(m_uiMesh, m_mpi_ctx,
                                      {{ evolution_num_vars }},
                                      {{ project_upper }}_ASYNC_COMM_K);
    for (unsigned int i = 0; i < VL::END; i++) m_var[i].destroy_vector();

    m_var[VL::CPU_EV].create_vector(newMesh, ot::DVEC_TYPE::OCT_SHARED_NODES,
        ot::DVEC_LOC::HOST, {{ evolution_num_vars }}, true);
    m_var[VL::CPU_EV_UZ_IN].create_vector(newMesh,
        ot::DVEC_TYPE::OCT_LOCAL_WITH_PADDING, ot::DVEC_LOC::HOST,
        {{ evolution_num_vars }}, true);
    m_var[VL::CPU_EV_UZ_OUT].create_vector(newMesh,
        ot::DVEC_TYPE::OCT_LOCAL_WITH_PADDING, ot::DVEC_LOC::HOST,
        {{ evolution_num_vars }}, true);
{% if constraint_num_vars > 0 %}
    m_var[VL::CPU_CV].create_vector(newMesh, ot::DVEC_TYPE::OCT_SHARED_NODES,
        ot::DVEC_LOC::HOST, {{ constraint_num_vars }}, true);
    m_var[VL::CPU_CV_UZ_IN].create_vector(newMesh,
        ot::DVEC_TYPE::OCT_LOCAL_WITH_PADDING, ot::DVEC_LOC::HOST,
        {{ constraint_num_vars }}, true);
{% endif %}
{% if enable_analytical %}
    m_var[VL::CPU_ANALYTIC].create_vector(newMesh,
        ot::DVEC_TYPE::OCT_SHARED_NODES, ot::DVEC_LOC::HOST,
        {{ evolution_num_vars }}, true);
    m_var[VL::CPU_ANALYTIC_DIFF].create_vector(newMesh,
        ot::DVEC_TYPE::OCT_SHARED_NODES, ot::DVEC_LOC::HOST,
        {{ evolution_num_vars }}, true);
{% endif %}

    ot::alloc_mpi_ctx<DendroScalar>(newMesh, m_mpi_ctx,
                                    {{ evolution_num_vars }},
                                    {{ project_upper }}_ASYNC_COMM_K);

    // (6) active ranks load the evolution variables onto the new mesh.
    if (isActive) {
        int activeRank;
        MPI_Comm_rank(activeComm, &activeRank);
        DendroScalar *inVar[{{ evolution_num_vars }}];
        m_var[VL::CPU_EV].to_2d(inVar);
        sprintf(fname, "%s_%d_vars_%d.var",
                {{ project_upper }}_CHKPT_FILE_PREFIX.c_str(), slot, activeRank);
        readStatus = io::checkpoint::readVecFromFile(fname, newMesh, inVar,
                                                     {{ evolution_num_vars }});
    }
    MPI_Comm_free(&activeComm);
    par::Mpi_Allreduce(&readStatus, &readStatusG, 1, MPI_MAX, comm);
    if (readStatusG != 0) {
        if (!rank)
            std::cerr << "[{{ project_name }}] checkpoint variables (.var) read "
                         "failed/corrupt." << std::endl;
        MPI_Abort(comm, 0);
    }

    // (7) swap in the restored mesh; main re-sizes derivs + builds the ETS
    //     (which picks up the restored TSInfo) after initialize() returns.
    std::swap(m_uiMesh, newMesh);
    delete newMesh;

    if (!rank)
        std::cout << "[{{ project_name }}] checkpoint restore OK -- resuming at"
                  << " step " << m_uiTinfo._m_uiStep
                  << " t=" << m_uiTinfo._m_uiT << " (slot " << slot << ")"
                  << std::endl;
    return 0;
}

// =========================================================================
// black hole tracking
// =========================================================================

{% if enable_bh_tracking %}
void {{ project_upper }}Ctx::evolve_bh_loc() {
    // first call (e.g. step 0): seed the history, nothing to integrate yet
    if (m_uiBHTimeHistory.empty()) {
        store_bh_loc_history();
        return;
    }
    // dt since the last tracked time; guard against a repeat call at same t
    const double dt = m_uiTinfo._m_uiT - m_uiBHTimeHistory.back();
    if (dt <= 0.0) return;

    DVec &m_evar = m_var[VL::CPU_EV];
    m_uiMesh->readFromGhostBegin(m_evar.get_vec_ptr(), m_evar.get_dof());
    m_uiMesh->readFromGhostEnd(m_evar.get_vec_ptr(), m_evar.get_dof());
    DendroScalar *evar[{{ evolution_num_vars }}];
    m_evar.to_2d(evar);

    const unsigned int beta_idx[3] = {VAR::U_BETA0, VAR::U_BETA1, VAR::U_BETA2};
    Point grid_limits[2] = {
        Point({{ project_upper }}_OCTREE_MIN[0], {{ project_upper }}_OCTREE_MIN[1],
              {{ project_upper }}_OCTREE_MIN[2]),
        Point({{ project_upper }}_OCTREE_MAX[0], {{ project_upper }}_OCTREE_MAX[1],
              {{ project_upper }}_OCTREE_MAX[2])};
    Point domain_limits[2] = {
        Point({{ project_upper }}_COMPD_MIN[0], {{ project_upper }}_COMPD_MIN[1],
              {{ project_upper }}_COMPD_MIN[2]),
        Point({{ project_upper }}_COMPD_MAX[0], {{ project_upper }}_COMPD_MAX[1],
              {{ project_upper }}_COMPD_MAX[2])};

    Point newLoc[2];
    dendro_gr::trackPunctures(m_uiMesh, (double **)evar, beta_idx, m_uiBHLoc,
                              newLoc, 2, grid_limits, domain_limits, dt);

    // Pin an inert (mass-0) BH at its initial location; don't chase a
    // nonexistent well. No-op for a real binary (both > tol).
    constexpr double BH_ACTIVE_MASS_TOL = 1.0e-6;
    if (BH1.getBHMass() > BH_ACTIVE_MASS_TOL) m_uiBHLoc[0] = newLoc[0];
    if (BH2.getBHMass() > BH_ACTIVE_MASS_TOL) m_uiBHLoc[1] = newLoc[1];
    {{ project_upper }}_BH_LOC[0] = m_uiBHLoc[0];
    {{ project_upper }}_BH_LOC[1] = m_uiBHLoc[1];
    store_bh_loc_history();
}

void {{ project_upper }}Ctx::store_bh_loc_history() {
    m_uiBHLocHistory.push_back(std::make_pair(m_uiBHLoc[0], m_uiBHLoc[1]));
    m_uiBHTimeHistory.push_back(m_uiTinfo._m_uiT);
}

int {{ project_upper }}Ctx::write_bh_coords() {
    dendro_gr::writeBHTrajectory(m_uiMesh, m_uiBHLoc, 2, m_uiTinfo._m_uiStep,
                                 m_uiTinfo._m_uiT,
                                 {{ project_upper }}_PROFILE_FILE_PREFIX);
    return 0;
}

bool {{ project_upper }}Ctx::is_bh_merged(double tol) {
    if (m_bIsBHMerged) return true;
    // No binary to merge if either BH is inert. No-op for a real binary.
    constexpr double BH_ACTIVE_MASS_TOL = 1.0e-6;
    if (BH1.getBHMass() <= BH_ACTIVE_MASS_TOL ||
        BH2.getBHMass() <= BH_ACTIVE_MASS_TOL)
        return false;
    double dist = (m_uiBHLoc[0] - m_uiBHLoc[1]).abs();
    return dist < tol;
}

void {{ project_upper }}Ctx::set_is_merged(double time, uint32_t step) {
    m_bIsBHMerged = true;
    m_dMergeTime = time;
    m_uiMergeStep = step;
    {{ project_upper }}_BH_MERGE_TIME = time;
    {{ project_upper }}_BH_MERGE_STEP = step;
}
{% endif %}

void {{ project_upper }}Ctx::prepare_for_next_iter() {
    m_bConstraintsComputed = false;
}

int {{ project_upper }}Ctx::finalize() { return 0; }

