// -------------------------------------------------------------------------
// block-level dispatch -- iterates over octree blocks and calls per-block rhs
// -------------------------------------------------------------------------

void {{ project_name }}RHS(double **uzipVarsRHS, const double **uZipVars,
             const ot::Block *blkList, unsigned int numBlocks,
             const double curr_time, const double **uZipConstVars) {

    const Point pt_min({{ namespace }}::{{ project_upper }}_COMPD_MIN[0],
                       {{ namespace }}::{{ project_upper }}_COMPD_MIN[1],
                       {{ namespace }}::{{ project_upper }}_COMPD_MIN[2]);
    const Point pt_max({{ namespace }}::{{ project_upper }}_COMPD_MAX[0],
                       {{ namespace }}::{{ project_upper }}_COMPD_MAX[1],
                       {{ namespace }}::{{ project_upper }}_COMPD_MAX[2]);
    const Point oct_min({{ namespace }}::{{ project_upper }}_OCTREE_MIN[0],
                        {{ namespace }}::{{ project_upper }}_OCTREE_MIN[1],
                        {{ namespace }}::{{ project_upper }}_OCTREE_MIN[2]);
    const Point oct_max({{ namespace }}::{{ project_upper }}_OCTREE_MAX[0],
                        {{ namespace }}::{{ project_upper }}_OCTREE_MAX[1],
                        {{ namespace }}::{{ project_upper }}_OCTREE_MAX[2]);

    // ot::BlockGeometryRange yields per-block offset/sz/bflag/dx/ptmin/ptmax and
    // hoists the grid->physical scaling out of the per-block loop.
    for (const auto &b : ot::BlockGeometryRange(blkList, numBlocks, pt_min,
                                                pt_max, oct_min, oct_max))
        {{ project_name }}rhs(uzipVarsRHS, (const double **)uZipVars, b.offset,
                b.ptmin, b.ptmax, b.sz, b.bflag, curr_time,
                (const double **)uZipConstVars);
}

