// -------------------------------------------------------------------------
// sommerfeld radiation boundary conditions
//
// applies an outgoing-wave condition at domain boundaries:
//   f_rhs = -(1/r)(x*dxf + y*dyf + z*dzf + falloff*(f - f_asymptotic))
//
// each variable has its own falloff rate and asymptotic value, set by
// the config's set_bhs_falloff_and_asymptotic() call.
// -------------------------------------------------------------------------

void {{ project_name }}_bcs(double *f_rhs, const double *f,
              const double *dxf, const double *dyf, const double *dzf,
              const double *pmin, const double *pmax,
              const double f_falloff, const double f_asymptotic,
              const unsigned int *sz, const unsigned int &bflag) {

    const unsigned int nx = sz[0];
    const unsigned int ny = sz[1];
    const unsigned int nz = sz[2];

    double hx = (pmax[0] - pmin[0]) / (nx - 1);
    double hy = (pmax[1] - pmin[1]) / (ny - 1);
    double hz = (pmax[2] - pmin[2]) / (nz - 1);

    const unsigned int PW = {{ namespace }}::{{ project_upper }}_PADDING_WIDTH;

    unsigned int ib = PW;
    unsigned int jb = PW;
    unsigned int kb = PW;
    unsigned int ie = nx - PW;
    unsigned int je = ny - PW;
    unsigned int ke = nz - PW;

    double x, y, z;
    unsigned int pp;
    double inv_r;

    // apply on each boundary face that's flagged
    if (bflag & (1u << OCT_DIR_LEFT)) {
        for (unsigned int k = kb; k < ke; k++) {
            z = pmin[2] + k * hz;
            for (unsigned int j = jb; j < je; j++) {
                y = pmin[1] + j * hy;
                for (unsigned int i = ib; i < ib + PW; i++) {
                    x = pmin[0] + i * hx;
                    pp = i + nx * (j + ny * k);
                    inv_r = 1.0 / sqrt(x * x + y * y + z * z);
                    f_rhs[pp] = -inv_r * (x * dxf[pp] + y * dyf[pp] + z * dzf[pp]
                                + f_falloff * (f[pp] - f_asymptotic));
                }
            }
        }
    }

    if (bflag & (1u << OCT_DIR_RIGHT)) {
        for (unsigned int k = kb; k < ke; k++) {
            z = pmin[2] + k * hz;
            for (unsigned int j = jb; j < je; j++) {
                y = pmin[1] + j * hy;
                for (unsigned int i = ie - PW; i < ie; i++) {
                    x = pmin[0] + i * hx;
                    pp = i + nx * (j + ny * k);
                    inv_r = 1.0 / sqrt(x * x + y * y + z * z);
                    f_rhs[pp] = -inv_r * (x * dxf[pp] + y * dyf[pp] + z * dzf[pp]
                                + f_falloff * (f[pp] - f_asymptotic));
                }
            }
        }
    }

    if (bflag & (1u << OCT_DIR_DOWN)) {
        for (unsigned int k = kb; k < ke; k++) {
            z = pmin[2] + k * hz;
            for (unsigned int j = jb; j < jb + PW; j++) {
                y = pmin[1] + j * hy;
                for (unsigned int i = ib; i < ie; i++) {
                    x = pmin[0] + i * hx;
                    pp = i + nx * (j + ny * k);
                    inv_r = 1.0 / sqrt(x * x + y * y + z * z);
                    f_rhs[pp] = -inv_r * (x * dxf[pp] + y * dyf[pp] + z * dzf[pp]
                                + f_falloff * (f[pp] - f_asymptotic));
                }
            }
        }
    }

    if (bflag & (1u << OCT_DIR_UP)) {
        for (unsigned int k = kb; k < ke; k++) {
            z = pmin[2] + k * hz;
            for (unsigned int j = je - PW; j < je; j++) {
                y = pmin[1] + j * hy;
                for (unsigned int i = ib; i < ie; i++) {
                    x = pmin[0] + i * hx;
                    pp = i + nx * (j + ny * k);
                    inv_r = 1.0 / sqrt(x * x + y * y + z * z);
                    f_rhs[pp] = -inv_r * (x * dxf[pp] + y * dyf[pp] + z * dzf[pp]
                                + f_falloff * (f[pp] - f_asymptotic));
                }
            }
        }
    }

    if (bflag & (1u << OCT_DIR_BACK)) {
        for (unsigned int k = kb; k < kb + PW; k++) {
            z = pmin[2] + k * hz;
            for (unsigned int j = jb; j < je; j++) {
                y = pmin[1] + j * hy;
                for (unsigned int i = ib; i < ie; i++) {
                    x = pmin[0] + i * hx;
                    pp = i + nx * (j + ny * k);
                    inv_r = 1.0 / sqrt(x * x + y * y + z * z);
                    f_rhs[pp] = -inv_r * (x * dxf[pp] + y * dyf[pp] + z * dzf[pp]
                                + f_falloff * (f[pp] - f_asymptotic));
                }
            }
        }
    }

    if (bflag & (1u << OCT_DIR_FRONT)) {
        for (unsigned int k = ke - PW; k < ke; k++) {
            z = pmin[2] + k * hz;
            for (unsigned int j = jb; j < je; j++) {
                y = pmin[1] + j * hy;
                for (unsigned int i = ib; i < ie; i++) {
                    x = pmin[0] + i * hx;
                    pp = i + nx * (j + ny * k);
                    inv_r = 1.0 / sqrt(x * x + y * y + z * z);
                    f_rhs[pp] = -inv_r * (x * dxf[pp] + y * dyf[pp] + z * dzf[pp]
                                + f_falloff * (f[pp] - f_asymptotic));
                }
            }
        }
    }
}

void freeze_bcs(double *f_rhs, const unsigned int *sz,
                const unsigned int &bflag) {
    const unsigned int nx = sz[0];
    const unsigned int ny = sz[1];
    const unsigned int nz = sz[2];
    const unsigned int PW = {{ namespace }}::{{ project_upper }}_PADDING_WIDTH;

    unsigned int ib = PW, jb = PW, kb = PW;
    unsigned int ie = nx - PW, je = ny - PW, ke = nz - PW;

    // zero out rhs at each flagged boundary face
    if (bflag & (1u << OCT_DIR_LEFT))
        for (unsigned int k = kb; k < ke; k++)
            for (unsigned int j = jb; j < je; j++)
                for (unsigned int i = ib; i < ib + PW; i++)
                    f_rhs[i + nx * (j + ny * k)] = 0.0;

    if (bflag & (1u << OCT_DIR_RIGHT))
        for (unsigned int k = kb; k < ke; k++)
            for (unsigned int j = jb; j < je; j++)
                for (unsigned int i = ie - PW; i < ie; i++)
                    f_rhs[i + nx * (j + ny * k)] = 0.0;

    if (bflag & (1u << OCT_DIR_DOWN))
        for (unsigned int k = kb; k < ke; k++)
            for (unsigned int j = jb; j < jb + PW; j++)
                for (unsigned int i = ib; i < ie; i++)
                    f_rhs[i + nx * (j + ny * k)] = 0.0;

    if (bflag & (1u << OCT_DIR_UP))
        for (unsigned int k = kb; k < ke; k++)
            for (unsigned int j = je - PW; j < je; j++)
                for (unsigned int i = ib; i < ie; i++)
                    f_rhs[i + nx * (j + ny * k)] = 0.0;

    if (bflag & (1u << OCT_DIR_BACK))
        for (unsigned int k = kb; k < kb + PW; k++)
            for (unsigned int j = jb; j < je; j++)
                for (unsigned int i = ib; i < ie; i++)
                    f_rhs[i + nx * (j + ny * k)] = 0.0;

    if (bflag & (1u << OCT_DIR_FRONT))
        for (unsigned int k = ke - PW; k < ke; k++)
            for (unsigned int j = jb; j < je; j++)
                for (unsigned int i = ib; i < ie; i++)
                    f_rhs[i + nx * (j + ny * k)] = 0.0;
}
