/**
 * @file {{ project_name }}_main.cpp
 * @brief Main entry point for the {{ project_name }} solver.
 *
 * Generated by dendrosym. Safe to edit -- add custom diagnostics,
 * change the evolution loop, add post-processing steps, etc.
 *
 * Based on the EM4 solver main from dendrolib.
 */

#include <algorithm>
#include <iostream>
#include <vector>

#include "TreeNode.h"
#include "dendro.h"
#include "ets.h"
#include "mesh.h"
#include "meshUtils.h"
#include "mpi.h"
#include "octUtils.h"

#include "grDef.h"
#include "grUtils.h"
#include "parameters.h"
#include "{{ project_name }}Ctx.h"
{% if tpid_writer %}
#include "TwoPunctures.h"
#include "{{ project_name }}_tpid_writer.h"
{% endif %}

#ifndef NRM
#define NRM "\x1B[0m"
#define YLW "\x1B[33m"
#define GRN "\x1B[32m"
#endif

int main(int argc, char **argv) {
    MPI_Init(&argc, &argv);
    MPI_Comm comm = MPI_COMM_WORLD;

    int rank, npes;
    MPI_Comm_rank(comm, &rank);
    MPI_Comm_size(comm, &npes);

    if (argc < 2) {
        if (rank == 0)
            std::cerr << "Usage: " << argv[0] << " <parameter_file.toml>" << std::endl;
        MPI_Finalize();
        return 1;
    }

    // read parameters
    {{ namespace }}::readParamFile(argv[1], comm);

{% if tpid_writer %}
    TPID::registerPunctureVarsWriter({{ tpid_writer }});
{% endif %}

    if (rank == 0) {
        std::cout << GRN << "========================================" << NRM << std::endl;
        std::cout << GRN << "  {{ project_upper }} Solver" << NRM << std::endl;
        std::cout << "  Processes: " << npes << std::endl;
        std::cout << "  Element order: " << {{ namespace }}::{{ project_upper }}_ELE_ORDER << std::endl;
        std::cout << "  Max depth: " << {{ namespace }}::{{ project_upper }}_MAXDEPTH << std::endl;
        std::cout << "  Evolution variables: {{ evolution_num_vars }}" << std::endl;
{% if constraint_num_vars > 0 %}
        std::cout << "  Constraint variables: {{ constraint_num_vars }}" << std::endl;
{% endif %}
        std::cout << GRN << "========================================" << NRM << std::endl;
    }

    // mesh generation
    _InitializeHcurve({{ namespace }}::{{ project_upper }}_DIM);

    // set the dendrolib globals for max depth and element order
    m_uiMaxDepth = {{ namespace }}::{{ project_upper }}_MAXDEPTH;

    const unsigned int eOrder = {{ namespace }}::{{ project_upper }}_ELE_ORDER;

    // mesh-refinement IC: cheap estimate for singular ICs; full IC applied
    // by ctx->init_grid() below.
    std::function<void(double, double, double, double *)> f_init =
        [](double x, double y, double z, double *var) {
            {{ namespace }}::initDataFuncToPhysCoordsForMesh(x, y, z, var);
        };

    std::vector<ot::TreeNode> tmpNodes;

    const unsigned int interpVars = {{ evolution_num_vars }};
    unsigned int varIndex[{{ evolution_num_vars }}];
    for (unsigned int i = 0; i < {{ evolution_num_vars }}; i++) varIndex[i] = i;

    // cap function2Octree depth (mirrors dendrogr_upstream BSSN pattern); the
    // remaining levels are reached by the init_grid_iter loop below.
{% if enable_bh_tracking %}
    const unsigned int bh_max_lev =
        std::min({{ namespace }}::{{ project_upper }}_BH1_MAX_LEV,
                 {{ namespace }}::{{ project_upper }}_BH2_MAX_LEV);
    if (bh_max_lev < MAXDEAPTH_LEVEL_DIFF + 2) {
        if (rank == 0)
            std::cerr << "BH max level (" << bh_max_lev
                      << ") must be at least " << (MAXDEAPTH_LEVEL_DIFF + 2)
                      << std::endl;
        MPI_Abort(comm, 0);
    }
    unsigned int maxDepthIn = bh_max_lev - MAXDEAPTH_LEVEL_DIFF - 2;
{% else %}
    unsigned int maxDepthIn = m_uiMaxDepth - 2;
{% endif %}

    if ({{ namespace }}::{{ project_upper }}_ENABLE_BLOCK_ADAPTIVITY) {
        // block-adaptive mode (matches BSSN_GR bssngr_main.cpp:291):
        // uniform grid at MAXDEPTH-2 inside [BLK_MIN, BLK_MAX]; the
        // -2 leaves headroom for the mesh constructor's 2:1 balancing
        // outside the box. Set MAXDEPTH = (desired-uniform-level)+2
        // to choose the in-box resolution.
        // X_TO_GRIDX/Y/Z relies on OCTREE_MAX being set to (1<<MAXDEPTH)
        // at TOML-load time (see parameters.cpp.j2).
        const unsigned int regLev =
            {{ namespace }}::{{ project_upper }}_MAXDEPTH - 2;

        if (rank == 0)
            std::cout << YLW
                      << "Using block adaptive mesh at level " << regLev
                      << " inside [BLK_MIN, BLK_MAX]. AMR disabled."
                      << NRM << std::endl;

        const Point blk_pt_min({{ namespace }}::{{ project_upper }}_BLK_MIN_X,
                               {{ namespace }}::{{ project_upper }}_BLK_MIN_Y,
                               {{ namespace }}::{{ project_upper }}_BLK_MIN_Z);
        const Point blk_pt_max({{ namespace }}::{{ project_upper }}_BLK_MAX_X,
                               {{ namespace }}::{{ project_upper }}_BLK_MAX_Y,
                               {{ namespace }}::{{ project_upper }}_BLK_MAX_Z);

        const unsigned int xRange_b = (unsigned int) X_TO_GRIDX(blk_pt_min.x());
        const unsigned int yRange_b = (unsigned int) Y_TO_GRIDY(blk_pt_min.y());
        const unsigned int zRange_b = (unsigned int) Z_TO_GRIDZ(blk_pt_min.z());
        const unsigned int xRange_e = (unsigned int) X_TO_GRIDX(blk_pt_max.x());
        const unsigned int yRange_e = (unsigned int) Y_TO_GRIDY(blk_pt_max.y());
        const unsigned int zRange_e = (unsigned int) Z_TO_GRIDZ(blk_pt_max.z());

        const unsigned int stepSz = 1u << (m_uiMaxDepth - regLev);
        const unsigned int octMax = 1u << m_uiMaxDepth;

        for (unsigned int x = xRange_b; x < xRange_e; x += stepSz)
            for (unsigned int y = yRange_b; y < yRange_e; y += stepSz)
                for (unsigned int z = zRange_b; z < zRange_e; z += stepSz) {
                    unsigned int xc = (x >= octMax) ? x - 1 : x;
                    unsigned int yc = (y >= octMax) ? y - 1 : y;
                    unsigned int zc = (z >= octMax) ? z - 1 : z;
                    tmpNodes.push_back(
                        ot::TreeNode(xc, yc, zc, regLev, m_uiDim, m_uiMaxDepth));
                }
    } else {
        if (rank == 0)
            std::cout << YLW << "Using function2Octree. AMR enabled." << NRM
                      << std::endl;

        function2Octree(f_init, {{ evolution_num_vars }}, varIndex, interpVars,
                        tmpNodes, maxDepthIn,
                        {{ namespace }}::{{ project_upper }}_WAVELET_TOL,
                        eOrder, comm);
    }

    // if the wavelet test won't trigger (e.g. flat IC), enable block_adaptivity
    // in TOML so the mesh seeds uniformly at MAXDEPTH-2 inside [BLK_MIN, BLK_MAX]

    if (rank == 0) std::cout << "Now generating mesh" << std::endl;

    ot::Mesh *mesh = ot::createMesh(
        tmpNodes.data(), tmpNodes.size(), eOrder, comm, 1,
        ot::SM_TYPE::FDM, {{ namespace }}::{{ project_upper }}_DENDRO_GRAIN_SZ,
        {{ namespace }}::{{ project_upper }}_LOAD_IMB_TOL,
        {{ namespace }}::{{ project_upper }}_SPLIT_FIX);

    mesh->setDomainBounds(
        Point({{ namespace }}::{{ project_upper }}_GRID_MIN_X,
              {{ namespace }}::{{ project_upper }}_GRID_MIN_Y,
              {{ namespace }}::{{ project_upper }}_GRID_MIN_Z),
        Point({{ namespace }}::{{ project_upper }}_GRID_MAX_X,
              {{ namespace }}::{{ project_upper }}_GRID_MAX_Y,
              {{ namespace }}::{{ project_upper }}_GRID_MAX_Z));

    tmpNodes.clear();

    if (rank == 0) std::cout << "Mesh created successfully." << std::endl;

    // allocate derivative workspace (sized for the largest block)
    {
        const auto &blkList = mesh->getLocalBlockList();
        unsigned int max_blk_sz = 0;
        for (unsigned int i = 0; i < blkList.size(); i++) {
            unsigned int bsz = blkList[i].getAllocationSzX() *
                               blkList[i].getAllocationSzY() *
                               blkList[i].getAllocationSzZ();
            if (bsz > max_blk_sz) max_blk_sz = bsz;
        }
        {{ namespace }}::{{ project_upper }}_DERIV_WORKSPACE =
            new double[{{ namespace }}::{{ project_upper }}_NUM_DERIVATIVES * max_blk_sz];
    }

    // ctx first; ETS comes after init_grid_iter so its state is sized to
    // the refined mesh.
    {{ namespace }}::{{ project_upper }}Ctx *ctx =
        new {{ namespace }}::{{ project_upper }}Ctx(mesh);

    // apply real IC once, then refine; intergrid transfer interpolates so
    // the expensive IC is only evaluated at the initial coarse mesh.
    ctx->initialize();
    // On restore, the mesh + state come straight from the checkpoint; skip the
    // initial-refinement loop so we don't remesh/alter the restored grid.
    if (!{{ namespace }}::{{ project_upper }}_RESTORE_SOLVER) {
        const unsigned int max_iter =
            {{ namespace }}::{{ project_upper }}_INIT_GRID_ITER;
        if (rank == 0)
            std::cout << YLW << "Starting init_grid_iter loop (max="
                      << max_iter << " iters)" << NRM << std::endl;
        for (unsigned int iter = 1; iter <= max_iter; iter++) {
            if (!ctx->is_remesh()) {
                if (rank == 0)
                    std::cout << "[init_grid_iter " << iter
                              << "] mesh converged (is_remesh=false)"
                              << std::endl;
                break;
            }
            DendroIntL old_el_l = ctx->get_mesh()->getNumLocalMeshElements();
            ctx->remesh_and_gridtransfer(
                {{ namespace }}::{{ project_upper }}_DENDRO_GRAIN_SZ,
                {{ namespace }}::{{ project_upper }}_LOAD_IMB_TOL,
                {{ namespace }}::{{ project_upper }}_SPLIT_FIX);
            DendroIntL new_el_l = ctx->get_mesh()->getNumLocalMeshElements();
            // Allreduce, not Reduce -- the convergence check below uses
            // these on every rank, so they must be globally consistent.
            DendroIntL old_el_g = 0, new_el_g = 0;
            par::Mpi_Allreduce(&old_el_l, &old_el_g, 1, MPI_SUM, comm);
            par::Mpi_Allreduce(&new_el_l, &new_el_g, 1, MPI_SUM, comm);
            if (rank == 0)
                std::cout << "[init_grid_iter " << iter
                          << "] elements " << old_el_g << " -> "
                          << new_el_g << std::endl;
            mesh = ctx->get_mesh();
            if (new_el_g == old_el_g) {
                if (rank == 0)
                    std::cout << "[init_grid_iter " << iter
                              << "] mesh converged (stable element count)"
                              << std::endl;
                break;
            }
        }
    }

    // keep the local mesh pointer current: init_grid_iter (or a checkpoint
    // restore) may have replaced the mesh inside the ctx, leaving the original
    // `mesh` dangling. Track ctx->get_mesh() so the final `delete mesh` is safe.
    mesh = ctx->get_mesh();

    if ({{ namespace }}::{{ project_upper }}_DERIV_WORKSPACE != nullptr) {
        delete[] {{ namespace }}::{{ project_upper }}_DERIV_WORKSPACE;
        const auto &blkList2 = ctx->get_mesh()->getLocalBlockList();
        unsigned int max_blk_sz2 = 0;
        for (unsigned int i = 0; i < blkList2.size(); i++) {
            unsigned int bsz = blkList2[i].getAllocationSzX() *
                               blkList2[i].getAllocationSzY() *
                               blkList2[i].getAllocationSzZ();
            if (bsz > max_blk_sz2) max_blk_sz2 = bsz;
        }
        {{ namespace }}::{{ project_upper }}_DERIV_WORKSPACE =
            new double[{{ namespace }}::{{ project_upper }}_NUM_DERIVATIVES * max_blk_sz2];
    }

    ts::ETS<DendroScalar, {{ namespace }}::{{ project_upper }}Ctx> *ets =
        new ts::ETS<DendroScalar, {{ namespace }}::{{ project_upper }}Ctx>(ctx);

    ets->set_evolve_vars(ctx->get_evolution_vars());

    // configure RK method
    switch ({{ namespace }}::{{ project_upper }}_RK_TYPE) {
        case 0: ets->set_ets_coefficients(ts::ETSType::RK3); break;
        case 1: ets->set_ets_coefficients(ts::ETSType::RK4); break;
        case 2: ets->set_ets_coefficients(ts::ETSType::RK45_CASH_KARP); break;
        default:
            if (rank == 0) std::cerr << "Unknown RK type, defaulting to RK4" << std::endl;
            ets->set_ets_coefficients(ts::ETSType::RK4);
    }

    ets->init();

    // initial dt from CFL on the finest level (else a no-remesh grid keeps the
    // par's fixed rk45_time_step_size). Same formula as the remesh block.
    {
        unsigned int lmin, lmax;
        ctx->get_mesh()->computeMinMaxLevel(lmin, lmax);
        {{ namespace }}::{{ project_upper }}_RK45_TIME_STEP_SIZE =
            {{ namespace }}::{{ project_upper }}_CFL_FACTOR *
            (({{ namespace }}::{{ project_upper }}_COMPD_MAX[0] -
              {{ namespace }}::{{ project_upper }}_COMPD_MIN[0]) *
             ((1u << (m_uiMaxDepth - lmax)) /
              ((double){{ namespace }}::{{ project_upper }}_ELE_ORDER)) /
             ((double)(1u << m_uiMaxDepth)));
        ts::TSInfo ts_in = ctx->get_ts_info();
        ts_in._m_uiTh = {{ namespace }}::{{ project_upper }}_RK45_TIME_STEP_SIZE;
        ctx->set_ts_info(ts_in);
    }

    if (rank == 0)
        std::cout << "Time stepper initialized. dt="
                  << {{ namespace }}::{{ project_upper }}_RK45_TIME_STEP_SIZE
                  << std::endl;

    // main evolution loop
    const double time_end = {{ namespace }}::{{ project_upper }}_RK_TIME_END;
    const unsigned int io_freq = {{ namespace }}::{{ project_upper }}_IO_OUTPUT_FREQ;
    const unsigned int ts_output_freq = {{ namespace }}::{{ project_upper }}_TIME_STEP_OUTPUT_FREQ;
    const unsigned int checkpt_freq = {{ namespace }}::{{ project_upper }}_CHECKPT_FREQ;
    unsigned int remesh_freq = {{ namespace }}::{{ project_upper }}_REMESH_TEST_FREQ;

    ctx->compute_constraint_variables();
    ctx->write_grid_summary_data();

    while (ets->curr_time() < time_end) {
        const unsigned int step = ets->curr_step();
        const double time = ets->curr_time();

        // periodic remeshing
        if (remesh_freq > 0 && (step % remesh_freq) == 0 && step != 0) {
            if (ctx->is_remesh()) {
                if (rank == 0)
                    std::cout << "[Remesh] step=" << step << std::endl;

                // this does: remesh -> grid_transfer -> swap meshes
                ctx->remesh_and_gridtransfer(
                    {{ namespace }}::{{ project_upper }}_DENDRO_GRAIN_SZ,
                    {{ namespace }}::{{ project_upper }}_LOAD_IMB_TOL,
                    {{ namespace }}::{{ project_upper }}_SPLIT_FIX);

                // reallocate derivative workspace for new mesh block sizes
                if ({{ namespace }}::{{ project_upper }}_DERIV_WORKSPACE != nullptr)
                    delete[] {{ namespace }}::{{ project_upper }}_DERIV_WORKSPACE;
                {
                    const auto &newBlkList = ctx->get_mesh()->getLocalBlockList();
                    unsigned int new_max_blk_sz = 0;
                    for (unsigned int b = 0; b < newBlkList.size(); b++) {
                        unsigned int bsz = newBlkList[b].getAllocationSzX() *
                                           newBlkList[b].getAllocationSzY() *
                                           newBlkList[b].getAllocationSzZ();
                        if (bsz > new_max_blk_sz) new_max_blk_sz = bsz;
                    }
                    {{ namespace }}::{{ project_upper }}_DERIV_WORKSPACE =
                        new double[{{ namespace }}::{{ project_upper }}_NUM_DERIVATIVES * new_max_blk_sz];
                }

                // sync the time stepper with the new mesh
                ets->sync_with_mesh();

                // recompute dt based on new finest level
                unsigned int lmin, lmax;
                ctx->get_mesh()->computeMinMaxLevel(lmin, lmax);
                {{ namespace }}::{{ project_upper }}_RK45_TIME_STEP_SIZE =
                    {{ namespace }}::{{ project_upper }}_CFL_FACTOR *
                    (({{ namespace }}::{{ project_upper }}_COMPD_MAX[0] -
                      {{ namespace }}::{{ project_upper }}_COMPD_MIN[0]) *
                     ((1u << (m_uiMaxDepth - lmax)) /
                      ((double){{ namespace }}::{{ project_upper }}_ELE_ORDER)) /
                     ((double)(1u << m_uiMaxDepth)));
                ts::TSInfo ts_in = ctx->get_ts_info();
                ts_in._m_uiTh = {{ namespace }}::{{ project_upper }}_RK45_TIME_STEP_SIZE;
                ctx->set_ts_info(ts_in);

                ctx->calculate_full_grid_size();

                // update local mesh pointer (old one was deleted during remesh)
                mesh = ctx->get_mesh();

                if (rank == 0)
                    std::cout << "[Remesh] new elements="
                              << mesh->getNumLocalMeshElements()
                              << " dt=" << ts_in._m_uiTh << std::endl;
            }
        }

{% if enable_bh_tracking %}
        ctx->evolve_bh_loc();

        if (ctx->is_bh_merged(0.1) && !ctx->is_bh_merged(0.0)) {
            ctx->set_is_merged(time, step);
            if (rank == 0)
                std::cout << "[MERGER DETECTED] t=" << time << std::endl;
        }

        if ((step % ts_output_freq) == 0) {
            ctx->write_bh_coords();
        }
{% endif %}

        if ((step % ts_output_freq) == 0) {
            ctx->terminal_output();
        }

        if (io_freq > 0 && (step % io_freq) == 0) {
            ctx->compute_constraint_variables();
            ctx->write_vtu();
        }

{% if enable_gw_extraction %}
        // gravitational wave extraction
        if ({{ namespace }}::{{ project_upper }}_GW_EXTRACT_FREQ > 0 &&
            (step % {{ namespace }}::{{ project_upper }}_GW_EXTRACT_FREQ) == 0) {
            ctx->extract_gravitational_waves();
        }
{% endif %}

{% if enable_ah %}
#ifdef SOLVER_ENABLE_AH
        // apparent horizon finder
        if (AH::AH_SOLVER_FREQ > 0 && (step % AH::AH_SOLVER_FREQ) == 0) {
            ctx->findAH();
        }
#endif
{% endif %}

        ets->evolve();

        if (checkpt_freq > 0 && (step % checkpt_freq) == 0 && step != 0) {
            ctx->write_checkpt();
        }

        ctx->prepare_for_next_iter();
    }

    // final output
    ctx->compute_constraint_variables();
    ctx->write_vtu();

    if (rank == 0) {
        std::cout << GRN << "========================================" << NRM << std::endl;
        std::cout << GRN << "  {{ project_upper }} Solver complete." << NRM << std::endl;
        std::cout << "  Final step: " << ets->curr_step() << std::endl;
        std::cout << "  Final time: " << ets->curr_time() << std::endl;
        std::cout << GRN << "========================================" << NRM << std::endl;
    }

    delete ets;
    delete ctx;
    delete mesh;

    if ({{ namespace }}::{{ project_upper }}_DERIV_WORKSPACE != nullptr)
        delete[] {{ namespace }}::{{ project_upper }}_DERIV_WORKSPACE;

    MPI_Finalize();
    return 0;
}
