int main(int argc, char **argv) {
    // =================================================================
    // 1. MPI & parameter initialization
    // =================================================================
    MPI_Init(&argc, &argv);
    MPI_Comm comm = MPI_COMM_WORLD;

    int rank, npes;
    MPI_Comm_rank(comm, &rank);
    MPI_Comm_size(comm, &npes);

    if (argc < 2) {
        if (rank == 0) {
            std::cerr << "Usage: " << argv[0] << " <parameter_file.toml>"
                      << std::endl;
        }
        MPI_Finalize();
        return 1;
    }

    // Read parameters from TOML file
    {{ namespace }}::readParamFile(argv[1], comm);

    if (rank == 0) {
        std::cout << "========================================" << std::endl;
        std::cout << "  {{ project_upper }} Solver" << std::endl;
        std::cout << "  Processes: " << npes << std::endl;
        std::cout << "  Element order: " << {{ namespace }}::{{ project_upper }}_ELE_ORDER
                  << std::endl;
        std::cout << "  Max depth: " << {{ namespace }}::{{ project_upper }}_MAXDEPTH
                  << std::endl;
        std::cout << "  Evolution variables: {{ evolution_num_vars }}" << std::endl;
{% if constraint_num_vars > 0 %}
        std::cout << "  Constraint variables: {{ constraint_num_vars }}" << std::endl;
{% endif %}
        std::cout << "========================================" << std::endl;
    }

    // Dump params to console for logging
    {{ namespace }}::dumpParamFile(std::cout, 0, comm);

    // =================================================================
    // 2. Mesh generation
    // =================================================================
    _InitializeHcurve({{ namespace }}::{{ project_upper }}_DIM);

    const unsigned int eOrder = {{ namespace }}::{{ project_upper }}_ELE_ORDER;
    const unsigned int maxDepth = {{ namespace }}::{{ project_upper }}_MAXDEPTH;

    // Domain bounds for the octree
    const Point domain_min({{ namespace }}::{{ project_upper }}_GRID_MIN_X,
                           {{ namespace }}::{{ project_upper }}_GRID_MIN_Y,
                           {{ namespace }}::{{ project_upper }}_GRID_MIN_Z);
    const Point domain_max({{ namespace }}::{{ project_upper }}_GRID_MAX_X,
                           {{ namespace }}::{{ project_upper }}_GRID_MAX_Y,
                           {{ namespace }}::{{ project_upper }}_GRID_MAX_Z);

    // Generate initial octree via wavelet-based refinement
    std::vector<ot::TreeNode> tmpNodes;
    std::function<void(double, double, double, double *)> f_init =
        [](double x, double y, double z, double *var) {
            {{ namespace }}::initDataFuncToPhysCoords(
                GRIDX_TO_X(x), GRIDY_TO_Y(y), GRIDZ_TO_Z(z), var);
        };

    function2Octree(f_init, {{ evolution_num_vars }}, {{ namespace }}::{{ project_upper }}_NUM_REFINE_VARS,
                    {{ namespace }}::{{ project_upper }}_REFINE_VARIABLE_INDICES,
                    tmpNodes, maxDepth, {{ namespace }}::{{ project_upper }}_WAVELET_TOL,
                    eOrder, comm);

    // Create mesh from octree
    ot::Mesh *mesh = ot::createMesh(
        tmpNodes.data(), tmpNodes.size(),
        eOrder, comm, 1,
        ot::SM_TYPE::FDM,
        {{ namespace }}::{{ project_upper }}_DENDRO_GRAIN_SZ,
        {{ namespace }}::{{ project_upper }}_LOAD_IMB_TOL,
        {{ namespace }}::{{ project_upper }}_SPLIT_FIX);

    mesh->setDomainBounds(domain_min, domain_max);
    tmpNodes.clear();

    if (rank == 0) {
        std::cout << "Mesh created successfully." << std::endl;
    }

    // =================================================================
    // 3. Context + time stepper creation
    // =================================================================

    // Allocate derivative workspace
    const unsigned int unzipSz = mesh->getDegOfFreedomUnZip();
    {{ namespace }}::{{ project_upper }}_DERIV_WORKSPACE =
        new double[{{ namespace }}::{{ project_upper }}_NUM_DERIVATIVES * unzipSz];

    // Create solver context
    {{ namespace }}::{{ project_upper }}Ctx *ctx =
        new {{ namespace }}::{{ project_upper }}Ctx(mesh);

    // Create explicit time stepper
    ts::ETS<DendroScalar, {{ namespace }}::{{ project_upper }}Ctx> *ets =
        new ts::ETS<DendroScalar, {{ namespace }}::{{ project_upper }}Ctx>(ctx);

    ets->set_evolve_vars(ctx->get_evolution_vars());

    // Configure RK method
    switch ({{ namespace }}::{{ project_upper }}_RK_TYPE) {
        case 0:
            ets->set_ets_coefficients(ts::ETSType::RK3);
            break;
        case 1:
            ets->set_ets_coefficients(ts::ETSType::RK4);
            break;
        case 2:
            ets->set_ets_coefficients(ts::ETSType::RK45);
            break;
        default:
            if (rank == 0)
                std::cerr << "Unknown RK type, defaulting to RK4" << std::endl;
            ets->set_ets_coefficients(ts::ETSType::RK4);
    }

    ets->init();

    if (rank == 0) {
        std::cout << "Time stepper initialized." << std::endl;
    }

    // =================================================================
    // 4. Main evolution loop
    // =================================================================
    const unsigned int time_end = {{ namespace }}::{{ project_upper }}_RK_TIME_END;
    const unsigned int io_freq = {{ namespace }}::{{ project_upper }}_IO_OUTPUT_FREQ;
    const unsigned int ts_output_freq = {{ namespace }}::{{ project_upper }}_TIME_STEP_OUTPUT_FREQ;
    const unsigned int checkpt_freq = {{ namespace }}::{{ project_upper }}_CHECKPT_FREQ;
    unsigned int remesh_freq = {{ namespace }}::{{ project_upper }}_REMESH_TEST_FREQ;

    // Initial constraint computation and output
    ctx->compute_constraint_variables();
    ctx->write_grid_summary_data();
    ctx->write_vtu();

    while (ets->curr_time() < time_end) {
        const unsigned int step = ets->curr_step();
        const double time = ets->curr_time();

        // ---- Periodic remeshing ----
        if (remesh_freq > 0 && (step % remesh_freq) == 0 && step != 0) {
            if (ctx->is_remesh()) {
                if (rank == 0)
                    std::cout << "[Remesh] step=" << step << std::endl;

                ot::Mesh *newMesh = mesh->ReMesh(
                    {{ namespace }}::{{ project_upper }}_WAVELET_TOL);

                if (newMesh != mesh) {
                    ctx->grid_transfer(newMesh);
                    mesh = newMesh;
                    ets->sync_with_mesh();
                    ctx->calculate_full_grid_size();
                    ctx->compute_constraint_variables();
                }
            }
        }

        // ---- Black hole tracking ----
        ctx->evolve_bh_loc();

        if (ctx->is_bh_merged(0.1) && !ctx->is_bh_merged(0.0)) {
            ctx->set_is_merged(time, step);
            if (rank == 0)
                std::cout << "[MERGER DETECTED] t=" << time << std::endl;
        }

        // ---- Terminal output ----
        if ((step % ts_output_freq) == 0) {
            ctx->terminal_output();
        }

        // ---- VTU output ----
        if ((step % io_freq) == 0) {
            ctx->compute_constraint_variables();
            ctx->write_vtu();
        }

        // ---- Advance one RK step ----
        ets->evolve();

        // ---- Checkpointing ----
        if (checkpt_freq > 0 && (step % checkpt_freq) == 0 && step != 0) {
            ctx->write_checkpt();
        }

        ctx->prepare_for_next_iter();
    }

    // =================================================================
    // 5. Final output and cleanup
    // =================================================================
    ctx->compute_constraint_variables();
    ctx->write_vtu();
    ctx->write_checkpt();

    if (rank == 0) {
        std::cout << "========================================" << std::endl;
        std::cout << "  {{ project_upper }} Solver complete." << std::endl;
        std::cout << "  Final step: " << ets->curr_step() << std::endl;
        std::cout << "  Final time: " << ets->curr_time() << std::endl;
        std::cout << "========================================" << std::endl;
    }

    delete ets;
    delete ctx;
    delete mesh;

    if ({{ namespace }}::{{ project_upper }}_DERIV_WORKSPACE != nullptr) {
        delete[] {{ namespace }}::{{ project_upper }}_DERIV_WORKSPACE;
    }

    MPI_Finalize();
    return 0;
}
