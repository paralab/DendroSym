#define Rz ({{ namespace }}::{{ project_upper }}_COMPD_MAX[2] - {{ namespace }}::{{ project_upper }}_COMPD_MIN[2])

#define RgX ({{ namespace }}::{{ project_upper }}_OCTREE_MAX[0] - {{ namespace }}::{{ project_upper }}_OCTREE_MIN[0])
#define RgY ({{ namespace }}::{{ project_upper }}_OCTREE_MAX[1] - {{ namespace }}::{{ project_upper }}_OCTREE_MIN[1])
#define RgZ ({{ namespace }}::{{ project_upper }}_OCTREE_MAX[2] - {{ namespace }}::{{ project_upper }}_OCTREE_MIN[2])

#define GRIDX_TO_X(xg) \
    (((Rx / RgX) * (xg - {{ namespace }}::{{ project_upper }}_OCTREE_MIN[0])) + {{ namespace }}::{{ project_upper }}_COMPD_MIN[0])
#define GRIDY_TO_Y(yg) \
    (((Ry / RgY) * (yg - {{ namespace }}::{{ project_upper }}_OCTREE_MIN[1])) + {{ namespace }}::{{ project_upper }}_COMPD_MIN[1])
#define GRIDZ_TO_Z(zg) \
    (((Rz / RgZ) * (zg - {{ namespace }}::{{ project_upper }}_OCTREE_MIN[2])) + {{ namespace }}::{{ project_upper }}_COMPD_MIN[2])

#define X_TO_GRIDX(xc) \
    (((RgX / Rx) * (xc - {{ namespace }}::{{ project_upper }}_COMPD_MIN[0])) + {{ namespace }}::{{ project_upper }}_OCTREE_MIN[0])
#define Y_TO_GRIDY(yc) \
    (((RgY / Ry) * (yc - {{ namespace }}::{{ project_upper }}_COMPD_MIN[1])) + {{ namespace }}::{{ project_upper }}_OCTREE_MIN[1])
#define Z_TO_GRIDZ(zc) \
    (((RgZ / Rz) * (zc - {{ namespace }}::{{ project_upper }}_COMPD_MIN[2])) + {{ namespace }}::{{ project_upper }}_OCTREE_MIN[2])

